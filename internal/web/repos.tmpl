{{define "repoResults" -}}
{{with .SearchError}}
<p class="banner ribbon mb-2" data-glyph="failed" role="status">gh search failed: {{.}}</p>
{{end}}
<div class="track-results" aria-label="repos found">
  {{range .Rows}}
  <div class="track-hit">
    <a class="font-mono" href="{{.Path}}">{{.FullName}}</a>
    {{if .Tracked}}<ul class="checks">{{range .Steps}}<li><span class="glyph glyph-{{.Glyph}}"><span class="sr-only">{{.Label}}: {{.Glyph}}</span></span></li>{{end}}</ul>
    {{else}}<span class="text-muted text-xs">not tracked{{with .RefusedBranch}} <span class="glyph glyph-failed text-s-failed">will be refused: default branch is <code>{{.}}</code></span>{{end}}</span>
    <a href="{{.Path}}">track &rarr;</a>{{end}}
  </div>
  {{else}}
  <p class="text-muted p-2">no repos match.</p>
  {{end}}
</div>
{{- end}}

{{define "repoGroups" -}}
{{range $g := .}}
<section class="mb-7 max-w-3xl" data-scope="{{.Scope.Kind}}">
  {{if eq .Scope.Kind "project" -}}
  <h2 class="flex items-center gap-2">
    <span class="avatar" data-hue="{{.Scope.Hue}}" aria-hidden="true">{{.Scope.Initial}}</span>
    {{.Scope.Label}}
    <span class="text-muted">{{.Count}} repo{{if ne .Count 1}}s{{end}}</span>
    <details class="text-base font-normal">
      <summary>edit</summary>
      <form method="post" action="/projects/{{.Scope.Value}}" hx-post="/projects/{{.Scope.Value}}"
        hx-target="#repo-results" hx-swap="innerHTML" class="flex items-center gap-2">
        <input type="text" name="name" required maxlength="40" value="{{.Scope.Value}}"
          autocomplete="off" aria-label="project name">
        {{range .Hues}}
        <label class="flex items-center gap-1"><input type="radio" name="hue" value="{{.}}"{{if eq . $g.Scope.Hue}} checked{{end}}>
          <span class="avatar" data-hue="{{.}}" aria-label="hue {{.}}">{{$g.Scope.Initial}}</span></label>
        {{end}}
        <button type="submit" class="btn btn-sm">Save</button>
      </form>
    </details>
    <form method="post" action="/projects/{{.Scope.Value}}/delete" hx-post="/projects/{{.Scope.Value}}/delete"
      hx-target="#repo-results" hx-swap="innerHTML" hx-confirm="Delete project {{.Scope.Value}}? Its repos stay tracked and become loose.">
      <button type="submit" class="btn btn-sm btn-danger">Delete</button>
    </form>
  </h2>
  {{- end}}
  <div class="repo-rows">
    {{range $row := .Rows}}
    <div class="repo-row">
      <a class="font-mono font-medium" href="{{.Path}}">{{.FullName}}</a>
      <ul class="checks" aria-label="checks">{{range .Steps}}<li><span class="glyph glyph-{{.Glyph}}"><span class="sr-only">{{.Label}}: {{.Glyph}}</span></span></li>{{end}}</ul>
      <form method="post" action="/repos/{{.FullName}}/project" hx-post="/repos/{{.FullName}}/project"
        hx-trigger="change" hx-target="#repo-results" hx-swap="innerHTML">
        <select name="project" aria-label="project of {{.FullName}}" class="select">
          <option value="">No project</option>
          {{range $g.Projects}}<option value="{{.}}"{{if eq . $row.Project}} selected{{end}}>{{.}}</option>{{end}}
        </select>
      </form>
    </div>
    {{end}}
  </div>
</section>
{{else}}
<p class="text-muted">no repos tracked.</p>
{{end}}
{{- end}}

{{define "newProject" -}}
<details class="mb-4 max-w-3xl">
  <summary>New project</summary>
  <form method="post" action="/projects" hx-post="/projects" hx-target="#repo-results" hx-swap="innerHTML"
    data-reset-on-success class="flex flex-col gap-2 mt-2">
    <input type="text" name="name" required maxlength="40" placeholder="project name"
      autocomplete="off" aria-label="project name">
    <fieldset class="flex items-center gap-3">
      <legend class="text-muted">hue</legend>
      {{range .Hues}}
      <label class="flex items-center gap-1"><input type="radio" name="hue" value="{{.}}"{{if eq . $.DefaultHue}} checked{{end}}>
        <span class="avatar" data-hue="{{.}}" aria-label="hue {{.}}">A</span></label>
      {{end}}
    </fieldset>
    <fieldset class="flex flex-col gap-1">
      <legend class="text-muted">repos</legend>
      {{range .Repos}}
      <label class="flex items-center gap-2"><input type="checkbox" name="repo" value="{{.}}"> {{.}}</label>
      {{end}}
    </fieldset>
    <button type="submit" class="btn btn-primary self-start">Create project</button>
  </form>
</details>
{{- end}}

{{define "importRefusal" -}}
{{with .}}
<p class="banner ribbon mb-2" data-glyph="failed" role="status">
  import of {{.Feature}} refused {{.Age}}. {{.Message}}
</p>
{{end}}
{{- end}}

{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<div class="page-narrow">
<h1>Repos</h1>
<p class="page-purpose">Agents only launch in repos that pass four checks: clone, squash-only merges, a main default branch and a valid settings file.</p>
{{template "importRefusal" .LastImportError}}
<input type="search" name="q" placeholder="Track a repo: search owner/name" autocomplete="off" aria-label="search repos"
  class="block w-full"
  hx-get="/repos/search" hx-trigger="input changed delay:300ms" hx-target="#repo-results" hx-swap="innerHTML">
<p class="text-muted text-xs mt-1 mb-3">Search runs as this box's gh identity.</p>
{{template "newProject" .NewProject}}
<div id="repo-results">
{{template "repoGroups" .Groups}}
</div>
</div>
{{template "shellEnd" .}}
