{{define "repoResults" -}}
{{with .SearchError}}
<p class="banner ribbon mb-2" data-glyph="failed" role="status">gh search failed: {{.}}</p>
{{end}}
<div class="track-results" aria-label="repos found">
  {{range .Rows}}
  <div class="track-hit">
    <a class="font-mono" href="{{.Path}}">{{.FullName}}</a>
    {{if .Tracked}}{{template "checks" .Steps}}
    {{else}}<span class="text-muted text-xs">not tracked{{with .RefusedBranch}} <span class="glyph glyph-failed text-s-failed">will be refused: default branch is <code>{{.}}</code></span>{{end}}</span>
    <a href="{{.Path}}">track &rarr;</a>{{end}}
  </div>
  {{else}}
  <p class="text-muted p-2">no repos match.</p>
  {{end}}
</div>
{{- end}}

{{define "checks" -}}<ul class="checks" aria-label="checks">{{range .}}<li><span class="glyph glyph-{{.Glyph}}"><span class="sr-only">{{.Label}}: {{.Glyph}}</span></span></li>{{end}}</ul>{{- end}}

{{define "repoGroups" -}}
{{range .}}
<section class="repo-group" data-scope="{{.Scope.Kind}}">
  <h2 class="repo-group-head">
    <span class="avatar"{{if .Scope.Initial}} data-hue="{{.Scope.Hue}}"{{end}} aria-hidden="true">{{.Scope.Initial}}</span>
    {{.Scope.Label}}
    <span class="text-muted">{{.Count}} repo{{if ne .Count 1}}s{{end}}</span>
  </h2>
  {{range .Rows}}
  <a class="repo-row" href="{{.Path}}" {{template "nav" .Path}}>
    <span class="glyph glyph-{{.Glyph}}"><span class="sr-only">{{.Status}}</span></span>
    <span class="repo-main"><b class="font-mono">{{.FullName}}</b><span{{if eq .Glyph "failed"}} class="repo-why"{{end}}>{{.Status}}</span></span>
    <span class="repo-count">{{if eq .Glyph "done"}}{{if .OpenTickets}}{{.OpenTickets}} open{{else}}No open tickets{{end}}{{else if eq .Glyph "failed"}}Refused{{else}}Checking{{end}}</span>
    {{template "icon" "chev"}}
  </a>
  {{end}}
</section>
{{else}}
<p class="text-muted">no repos tracked.</p>
{{end}}
{{- end}}

{{define "importRefusal" -}}
<p class="banner ribbon mb-2" data-glyph="failed" role="status">
  import of {{.Feature}} refused {{.Age}}. {{.Message}}
</p>
{{- end}}

{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<div class="page-narrow">
<h1>Repos</h1>
<p class="page-purpose">Agents only launch in repos that pass four checks: clone, squash-only merges, a main default branch and a valid settings file.</p>
{{if .LastImportError.IsSome}}{{template "importRefusal" .LastImportError.Unwrap}}{{end}}
<form method="get" action="/repos" role="search">
  <input type="search" name="q" value="{{.Query}}" placeholder="Track a repo: search owner/name" autocomplete="off"
    aria-label="search repos" class="block w-full"
    hx-get="/repos/search" hx-trigger="input changed delay:300ms" hx-target="#repo-results" hx-swap="innerHTML">
</form>
<p class="text-muted text-xs mt-1 mb-3">Search runs as this machine's <code>gh</code> identity.</p>
<div id="repo-results">
{{if .Search}}{{template "repoResults" .Search}}{{else}}{{template "repoGroups" .Groups}}{{end}}
</div>
</div>
{{template "shellEnd" .}}
