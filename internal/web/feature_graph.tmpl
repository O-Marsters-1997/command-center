{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
<a class="btn btn-primary" href="/f/{{.FeatureScope | pathEscape}}/launch" data-key="c" {{template "nav" (printf "/f/%s/launch" (.FeatureScope | pathEscape))}}>Launch</a>
{{template "shellContent" .}}
<nav class="pill-tabs" aria-label="feature views">
  <a class="pill-tab" href="/f/{{.FeatureScope | pathEscape}}" data-key="v" {{template "nav" (printf "/f/%s" (.FeatureScope | pathEscape))}}>Board</a>
  <a class="pill-tab" href="/f/{{.FeatureScope | pathEscape}}/graph" {{template "nav" (printf "/f/%s/graph" (.FeatureScope | pathEscape))}} aria-current="page">Graph</a>
</nav>
{{template "featureHead" .}}
<cc-graph data-src="/graph.json?feature={{.FeatureScope}}">
  <p class="banner ribbon" data-glyph="pending" role="status">
    the dependency graph needs the built assets: run `just assets`, or switch to the board.
  </p>
</cc-graph>
<script type="module" src="/assets/dist/graph.js"></script>
<div id="launch-modal"></div>
{{template "shellEnd" .}}
