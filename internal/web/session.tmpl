{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<article class="session" data-session="{{.Row.URL}}">
<div class="session-main">
  <header class="session-head">
    <span class="badge" data-glyph="{{.Row.Glyph}}"><span class="glyph glyph-{{.Row.Glyph}}{{if .Row.Alive}} glyph-pulse{{end}}">{{.Row.Label}}</span></span>
    <h1 class="session-ref">{{or .Row.Title .Ref}}</h1>
    <p class="session-meta text-muted font-mono">{{.Row.Repo}} {{.Ref}}{{with .Row.Branch}} · {{.}}{{end}}</p>
    {{- with .Row.Worktree}}
    <p class="session-worktree text-muted"><code>{{.}}</code></p>
    {{- end}}
    {{- if .Row.Log.PhaseCount}}
    <details class="worked">
      <summary><span class="worked-spark" aria-hidden="true">✻</span> {{.Row.Log.Worked.Label}}{{with .Row.Log.Worked.Stats}} <span class="worked-stats">{{.}}</span>{{end}}</summary>
      <p class="text-muted">lines {{.Row.Log.Lines}} · phases {{.Row.Log.PhaseCount}}</p>
    </details>
    {{- end}}
  </header>
  <section class="prompt" aria-label="prompt">
    <span class="prompt-meta text-muted">Launched from the ticket{{with .Launched}}{{if .IsSome}} · {{template "age" .Unwrap}}{{end}}{{end}}</span>
    <div class="prompt-bubble">
    {{- if .Prompt.Kept}}<pre class="prompt-text">{{.Prompt.Text}}</pre>
    {{- else}}<p class="prompt-gone text-muted">{{if .Row.LogPath}}The prompt was not kept.{{else}}No run has started yet.{{end}}</p>{{end}}
    </div>
  </section>
  <nav class="pill-tabs" aria-label="log view">
    <a class="pill-tab" href="{{.TranscriptPath}}" {{template "nav" .TranscriptPath}}{{if not .Raw}} aria-current="page"{{end}}>Transcript</a>
    <a class="pill-tab" href="{{.RawPath}}" {{template "nav" .RawPath}}{{if .Raw}} aria-current="page"{{end}}>Raw log</a>
  </nav>
  {{- if .Raw}}
  {{if .RawText}}<pre class="raw-log">{{.RawText}}</pre>{{else}}<p class="text-muted">No log was kept for this run.</p>{{end}}
  {{- else}}
  {{- if .Empty}}<p class="text-muted">Nothing to show yet: no run has written a log.</p>{{end}}
  <div class="run-thread">
    {{- range .Turns}}
    {{- with .You}}
    <div class="line line-you"><span class="line-label">you</span> {{.}}</div>
    {{- end}}
    <div class="run-work">
      {{- range .Log.Phases}}
      <section class="phase">
        <header class="phase-head flex items-baseline gap-2">
          <span class="phase-skill">{{if .Skill}}{{.Skill}}{{else}}start{{end}}</span>{{with .Note}}<span class="phase-note">{{.}}</span>{{end}}
          <span class="phase-rule"></span>
          <span class="phase-at">{{.At}}</span>
        </header>
        {{- range .Items}}
        {{if .Folded}}<details class="fold"{{if .Group.Open}} open{{end}}><summary>{{.Group.Summary}}{{with .Group.FailNote}} <span class="fold-fail">· {{.}}</span>{{end}}</summary><div class="fold-body">{{range .Group.Lines}}{{template "logline" .}}{{end}}</div></details>{{else if .FirstFail}}<span id="first-fail"></span>{{else}}{{template "logline" .Line}}{{end}}
        {{- end}}
      </section>
      {{- end}}
      {{- with .Log.StreamPath}}
      <div class="run-log-live" hx-ext="sse" sse-connect="{{.}}" sse-swap="message" sse-close="end" hx-swap="beforeend"></div>
      {{- end}}
    </div>
    {{- with .Log.Final}}
    <div class="run-final">{{template "logline" .}}</div>
    {{- end}}
    {{- with .Ask}}
    <div class="line line-ask"><span class="line-label">ask</span><span class="ask-text">{{.}}</span></div>
    {{- end}}
    {{- end}}
  </div>
  {{- end}}
  {{template "sessionActions" .}}
  {{template "sessionComposer" .}}
</div>
<button type="button" class="btn stack-toggle" popovertarget="stack-panel">Stack</button>
  <aside id="stack-panel" class="stack-panel" popover aria-label="feature stack">
    {{- if .Stack.Feature}}
    <h2 class="stack-title stack-feature">{{template "mark" .Stack.Project}}{{.Stack.Feature}}<span class="text-muted stack-progress">{{.Stack.Merged}}/{{.Stack.Total}} merged</span></h2>
    <div class="stack-links">
      <a class="btn btn-sm" href="{{.Stack.GraphPath}}" data-key="f" {{template "nav" .Stack.GraphPath}}>Graph</a>
      <a class="btn btn-sm" href="{{.Stack.BoardPath}}" {{template "nav" .Stack.BoardPath}}>Board</a>
    </div>
    {{- range .Stack.Waves}}
    <section class="stack-wave" aria-label="Wave {{.N}}">
      <h3 class="stack-wave-label text-muted">Wave {{.N}}</h3>
      <ul class="stack-list">{{range .Members}}<li class="stack-row"{{if .Current}} aria-current="page"{{end}}>{{template "stackLink" .}}</li>{{end}}</ul>
    </section>
    {{- end}}
    {{- else}}
    <h2 class="stack-title">Blocked by</h2>
    {{- if .Stack.Blockers}}
    <ul class="stack-list">{{range .Stack.Blockers}}<li class="stack-row">{{template "stackLink" .}}</li>{{end}}</ul>
    {{- else}}<p class="text-muted">Nothing blocks this ticket.</p>{{end}}
    <h2 class="stack-title">Merging this unlocks</h2>
    {{- if .Stack.Unlocks}}
    <ul class="stack-list">{{range .Stack.Unlocks}}<li class="stack-row">{{template "stackLink" .}}</li>{{end}}</ul>
    {{- else}}<p class="text-muted">Nothing waits on this ticket.</p>{{end}}
    {{- end}}
    <dl class="stack-props">
      <dt>Repo</dt><dd>{{.Row.Repo}}</dd>
      <dt>Branch</dt><dd class="mono">{{.Row.Branch}}</dd>
      <dt>PR</dt><dd>{{if .PRURL}}<a href="{{.PRURL}}" target="_blank" rel="noopener">#{{.Row.PRNumber}}</a>{{else}}—{{end}}</dd>
      <dt>Checks</dt><dd>{{if .Row.Checks}}{{.Row.ChecksPassed}}/{{len .Row.Checks}} passing{{else}}—{{end}}</dd>
      <dt>Spend</dt><dd class="mono">{{if gt .Row.SpendPctWeek 0.0}}{{printf "%.2f" .Row.SpendPctWeek}}% of week{{else}}—{{end}}</dd>
    </dl>
    <details class="stack-edit">
      <summary>Edit blockers</summary>
      <form method="post" action="/ticket" class="stack-form">
        <input type="hidden" name="ticket" value="{{.Row.URL}}">
        <input type="hidden" name="branch" value="{{.Row.Branch}}">
        <input type="hidden" name="return" value="{{.TranscriptPath}}">
        <fieldset class="stack-fields">
          <legend class="sr-only">Blockers</legend>
          {{- range .Row.BlockedBy}}
          <input type="text" name="blocked_by" value="{{.}}" aria-label="blocked by">
          {{- end}}
          <input type="text" name="blocked_by" placeholder="add a blocker URL" aria-label="add a blocker">
        </fieldset>
        <button type="submit" class="btn">save</button>
      </form>
    </details>
  </aside>
</article>
{{template "shellEnd" .}}{{define "sessionActions"}}<div id="session-actions" class="session-actions" hx-get="{{.ActionsPath}}" hx-trigger="every 5s" hx-sync="this:drop" hx-swap="outerHTML">
  {{- with .Toast}}<div id="toast" class="toast" hx-swap-oob="innerHTML" role="status">{{.}}</div>{{end}}
  <div class="verbs{{if .Callout}} callout{{end}}" data-glyph="{{.Row.Glyph}}">
    {{- $s := .}}
    {{- range .Actions}}
    <form method="post" action="/verb" hx-post="/verb" hx-disabled-elt="find button" hx-sync="closest #session-actions:replace" hx-target="#session-actions" hx-swap="outerHTML"{{with .Confirm}} hx-confirm="{{.}}"{{end}}>
      <input type="hidden" name="ticket" value="{{$s.Row.URL}}">
      <input type="hidden" name="from" value="session">
      <input type="hidden" name="return" value="{{$s.TranscriptPath}}">
      <button class="btn" type="submit" name="verb" value="{{.Verb}}"{{with .Key}} data-key="{{.}}"{{end}}{{if .Pending}} disabled{{end}}>{{.Label}}</button>
      {{- if .Pending}}<span class="pending-mark" data-glyph="pending">queued</span>{{end}}
    </form>
    {{- end}}
    {{- with .PRURL}}<a class="btn" href="{{.}}" data-key="o" target="_blank" rel="noopener">Open PR</a>{{end}}
    {{- if .Row.LogPath}}<a class="btn" href="{{.RawPath}}">Open log</a>{{end}}
  </div>
  {{- if .Running}}
  <p class="composer-running" data-glyph="running">Agent is running{{with .Row.Log.Worked.Stats}} · {{.}}{{end}}{{with .Row.Elapsed}} · {{.}}{{end}}</p>
  {{- end}}
  {{- range .PendingMessages}}
  <p class="pending-message" data-glyph="pending"><span class="text-muted">you</span> {{.}}</p>
  {{- end}}
</div>
{{- if .ResetComposer}}{{template "sessionComposer" .}}{{end}}{{end}}
{{define "sessionComposer"}}<div id="session-composer"{{if .ResetComposer}} hx-swap-oob="true"{{end}}>
  {{- if .Row.FollowUpAvailable}}
  <form class="composer" method="post" action="/verb" hx-post="/verb" hx-disabled-elt="find button" hx-target="#session-actions" hx-swap="outerHTML">
    <input type="hidden" name="ticket" value="{{.Row.URL}}">
    <input type="hidden" name="from" value="session">
    <input type="hidden" name="return" value="{{.TranscriptPath}}">
    <input type="hidden" name="verb" value="follow-up">
    <textarea name="prompt" rows="2" data-key="enter"{{if .AwaitingInput}} autofocus{{end}} required placeholder="{{if .AwaitingInput}}Answer the agent's question…{{else if .Running}}Send the running agent a message…{{else}}Send this run a follow-up prompt…{{end}}" aria-label="{{if .AwaitingInput}}reply{{else}}follow-up prompt{{end}}"></textarea>
    <div class="composer-bar">
      <span class="composer-chip" title="Model for this run">{{.Model}}</span>
      {{- with .Row.Worktree}}<span class="composer-chip" title="{{.}}" aria-label="Worktree {{.}}">worktree</span>{{end}}
      <button class="btn-send" type="submit" aria-label="{{if .AwaitingInput}}Reply{{else}}Send{{end}}">↑</button>
    </div>
  </form>
  {{- end}}
</div>{{end}}
{{define "stackLink"}}{{if .Glyph}}<span class="glyph glyph-{{.Glyph}}" data-glyph="{{.Glyph}}" aria-hidden="true"></span>{{end}}{{if .Path}}<a href="{{.Path}}">{{.Ref}}</a>{{else}}{{.Ref}}{{end}}{{with .Title}} <span class="stack-row-title">{{.}}</span>{{end}}{{with .Metric}}<span class="stack-row-metric font-mono text-muted">{{.}}</span>{{end}}{{end}}
