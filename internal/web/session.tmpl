{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<article class="session" data-session="{{.Row.URL}}">
<div class="session-main">
  <header class="session-head">
    <span class="badge" data-glyph="{{.Row.Glyph}}"><span class="glyph glyph-{{.Row.Glyph}}{{if .Row.Alive}} glyph-pulse{{end}}">{{.Row.Label}}</span></span>
    <h1 class="session-ref">{{or .Row.Title .Ref}}</h1>
    {{- if .Callout}}{{with .Row.Detail}}
    <p class="session-reason">{{.}}</p>
    {{- end}}{{end}}
    <p class="session-meta text-muted font-mono">{{.Row.Repo}} {{.Ref}}{{with .Row.Branch}} · {{.}}{{end}}</p>
    {{- with .Row.ProtectedLinks}}
    <section class="session-protected" aria-label="Protected changes">
      <h2 class="text-sm font-medium">Protected changes</h2>
      <ul class="font-mono text-xs">
        {{- range .}}
        <li>{{if .Href}}<a href="{{.Href}}" target="_blank" rel="noopener">{{.Path}}</a>{{else}}{{.Path}}{{end}} <span class="text-muted">{{.Rule}}</span> +{{.Added}} −{{.Deleted}}</li>
        {{- end}}
      </ul>
    </section>
    {{- end}}
    {{- with .Row.Worktree}}
    <p class="session-worktree text-muted"><code>{{.}}</code></p>
    {{- end}}
    {{- if .Row.Log.Worked.Label}}
    <details class="worked">
      <summary><span class="worked-spark" aria-hidden="true">✻</span> {{.Row.Log.Worked.Label}}{{with .Row.Log.Worked.Stats}} <span class="worked-stats">{{.}}</span>{{end}}</summary>
      {{- if .Row.Log.PhaseCount}}
      <p class="text-muted">lines {{.Row.Log.Lines}} · phases {{.Row.Log.PhaseCount}}</p>
      {{- end}}
    </details>
    {{- end}}
  </header>
  <section class="prompt" aria-label="prompt">
    <span class="prompt-meta text-muted">Launched from the ticket{{with .Launched}}{{if .IsSome}} · {{template "age" .Unwrap}}{{end}}{{end}}</span>
    <div class="prompt-bubble">
    {{- if .Prompt.Kept}}<pre class="prompt-text">{{.Prompt.Text}}</pre>
    {{- else}}<p class="prompt-gone text-muted">{{if .Row.LogPath}}The prompt was not kept.{{else}}No run has started yet.{{end}}</p>{{end}}
    </div>
    {{- with .Worked}}{{if .IsSome}}{{with .Unwrap}}
    <span class="prompt-worked text-muted font-mono">Worked{{if .SpendPctWeek}} · {{printf "%.1f" .SpendPctWeek}}% of week{{end}} · {{.Wall}}{{if .Turns}} · {{.Turns}} {{if eq .Turns 1}}turn{{else}}turns{{end}}{{end}}</span>
    {{- end}}{{end}}{{end}}
  </section>
  {{template "stepStrip" .}}
  <nav class="pill-tabs" aria-label="log view">
    <a class="pill-tab" href="{{.TranscriptPath}}" {{template "nav" .TranscriptPath}}{{if not .Raw}} aria-current="page"{{end}}>Transcript</a>
    <a class="pill-tab" href="{{.RawPath}}" {{template "nav" .RawPath}}{{if .Raw}} aria-current="page"{{end}}>Raw log</a>
    <a class="pill-tab" href="{{.ChangesPath}}" {{template "nav" .ChangesPath}}>Changes</a>
  </nav>
  {{- if .Raw}}
  {{- with .RawLog}}{{if .Total}}
  <form class="flex flex-wrap items-center gap-2 mb-3" method="get" action="{{$.TranscriptPath}}" role="search" {{template "nav" $.TranscriptPath}}>
    <input type="hidden" name="log" value="raw">
    <select name="kind" aria-label="kind">
      <option value="">all kinds</option>
      {{- range .Types}}<option value="{{.}}"{{if eq . $.RawLog.Filter.Type}} selected{{end}}>{{.}}</option>{{end}}
    </select>
    <input type="search" name="q" value="{{.Filter.Query}}" placeholder="Search the log" aria-label="search the log" autocomplete="off">
    <button class="btn" type="submit">Filter</button>
    <span class="text-muted text-xs">{{len .Lines}} of {{.Total}} lines</span>
  </form>
  {{- if .Lines}}
  <div class="table-frame"><table class="raw-table w-full" aria-label="raw log">
    <thead><tr><th scope="col">time</th><th scope="col">kind</th><th scope="col">tool</th><th scope="col">summary</th></tr></thead>
    <tbody>
      {{- range .Lines}}
      <tr id="raw-{{.N}}">
        <td class="font-mono">{{if .Failed}}<span class="glyph" data-glyph="failed" role="img" aria-label="failed"></span> {{end}}{{if not .At.IsZero}}{{.At.Format "15:04:05"}}{{end}}</td>
        <td>{{.Type}}</td>
        <td class="font-mono">{{.Tool}}</td>
        <td class="raw-summary"><details><summary>{{.Summary}}</summary><pre class="raw-log">{{.JSON}}</pre></details></td>
      </tr>
      {{- end}}
    </tbody>
  </table></div>
  {{- else}}<p class="text-muted">No lines match this filter.</p>{{end}}
  {{- else}}<p class="text-muted">No log was kept for this run.</p>{{end}}{{end}}
  {{- else}}
  {{- if .Empty}}<p class="text-muted">Nothing to show yet: no run has written a log.</p>{{end}}
  <div class="run-thread">
    {{- range .Turns}}
    {{- with .You}}
    <div class="line line-you"><span class="line-label">you</span> {{.}}</div>
    {{- end}}
    <div class="run-work">
      {{- range .Log.Phases}}
      <section class="phase">
        <header class="phase-head flex items-baseline gap-2">
          {{if .Skill}}{{template "skillPill" .Skill}}{{else}}<span class="phase-skill">start</span>{{end}}{{with .Note}}<span class="phase-note">{{.}}</span>{{end}}
          <span class="phase-rule"></span>
          <span class="phase-at">{{.At}}</span>
        </header>
        {{- range .Items}}
        {{if .Folded}}<details class="fold"><summary><span class="fold-count">{{.Group.Calls}} tool call{{if ne .Group.Calls 1}}s{{end}}</span>{{with .Group.Failed}} <span class="fold-fail">· {{.}} failed</span>{{end}} <span class="fold-mix">{{.Group.Mix}}</span></summary><div class="fold-body">{{range .Group.Lines}}{{template "logline" .}}{{end}}</div></details>{{else if .FirstFail}}<span id="first-fail"></span>{{else}}{{template "logline" .Line}}{{end}}
        {{- end}}
      </section>
      {{- end}}
      {{- with .Log.StreamPath}}
      <div class="run-log-live" hx-ext="sse" sse-connect="{{.}}" sse-swap="message" sse-close="end" hx-swap="beforeend"></div>
      {{- end}}
    </div>
    {{- with .Log.Final}}
    <div class="run-final">{{template "logline" .}}</div>
    {{- end}}
    {{- with .Ask}}
    <div class="line line-ask"><span class="line-label">ask</span><span class="ask-text">{{.}}</span></div>
    {{- end}}
    {{- end}}
  </div>
  {{- end}}
  {{template "sessionActions" .}}
  {{template "sessionComposer" .}}
</div>
<button type="button" class="btn stack-toggle" popovertarget="stack-panel">Stack</button>
  <aside id="stack-panel" class="stack-panel" popover aria-label="feature stack">
    {{- with .Stack}}
    {{- if .Feature}}
    <header class="flex flex-col gap-2">
      <h2 class="stack-title">{{template "mark" .Project}}<span>{{.Feature}}</span></h2>
      <div class="stack-progress">
        <span class="meter" data-glyph="done" role="meter" aria-valuenow="{{.MergedPercent}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{.Merged}} of {{.Total}} merged"><span class="meter-fill" style="width: {{.MergedPercent}}%"></span></span>
        <span class="font-mono">{{.Merged}}/{{.Total}} merged</span>
      </div>
      <nav class="stack-links" aria-label="Feature views">
        <a href="{{.GraphPath}}" data-key="f" {{template "nav" .GraphPath}}>Graph</a>
        <a href="{{.BoardPath}}" {{template "nav" .BoardPath}}>Board</a>
      </nav>
    </header>
    {{- end}}
    <section class="stack-section" aria-labelledby="stack-this">
      <h3 id="stack-this" class="stack-heading">This ticket</h3>
      {{- with .Blockers}}
      <p class="stack-sub">Blocked by</p>
      {{template "stackList" .}}
      {{- end}}
      {{- with .Unlocks}}
      <p class="stack-sub">Merging it unlocks</p>
      {{template "stackList" .}}
      {{- end}}
      {{- if not (or .Blockers .Unlocks)}}<p class="stack-none">Nothing blocks it and nothing waits on it.</p>{{end}}
    </section>
    {{- if .Feature}}
    <section class="stack-section" aria-labelledby="stack-live">
      <h3 id="stack-live" class="stack-heading">In flight <span class="stack-count">{{len .InFlight}}</span></h3>
      {{- with .InFlight}}{{template "stackList" .}}
      {{- else}}<p class="stack-none">Nothing is running in this feature.</p>{{end}}
      {{- range .Folds}}{{if .Links}}
      <details class="stack-fold">
        <summary>{{template "icon" "chev"}}{{.Label}}<span class="stack-count">{{len .Links}}</span></summary>
        {{template "stackList" .Links}}
      </details>
      {{- end}}{{end}}
    </section>
    {{- end}}
    {{- end}}
    <dl class="stack-props">
      <dt>PR</dt><dd>{{if .PRURL}}<a href="{{.PRURL}}" target="_blank" rel="noopener">#{{.Row.PRNumber}}</a>{{else}}—{{end}}</dd>
      <dt>Checks</dt><dd>{{if .Row.ChecksTotal}}{{.Row.ChecksPassed}}/{{.Row.ChecksTotal}} passing{{else}}—{{end}}</dd>
      <dt>Spend</dt><dd class="font-mono">{{if gt .Row.SpendPctWeek 0.0}}{{printf "%.2f" .Row.SpendPctWeek}}% of week{{else}}—{{end}}</dd>
    </dl>
    <details class="stack-fold stack-edit">
      <summary>{{template "icon" "chev"}}Edit blockers</summary>
      <form method="post" action="/ticket" class="stack-form">
        <input type="hidden" name="ticket" value="{{.Row.URL}}">
        <input type="hidden" name="branch" value="{{.Row.Branch}}">
        <input type="hidden" name="return" value="{{.TranscriptPath}}">
        <fieldset class="stack-fields">
          <legend class="sr-only">Blockers</legend>
          {{- range .Row.BlockedBy}}
          <input type="text" name="blocked_by" value="{{.}}" aria-label="blocked by">
          {{- end}}
          <input type="text" name="blocked_by" placeholder="add a blocker URL" aria-label="add a blocker">
        </fieldset>
        <button type="submit" class="btn">save</button>
      </form>
    </details>
  </aside>
</article>
{{template "shellEnd" .}}{{define "sessionActions"}}<div id="session-actions" class="session-actions" hx-get="{{.ActionsPath}}" hx-trigger="every 5s" hx-sync="this:drop" hx-swap="outerHTML">
  {{- with .Toast}}<div id="toast" class="toast" hx-swap-oob="innerHTML" role="status">{{.}}
    {{- if $.UndoID}}
    <form method="post" action="/verb/undo" hx-post="/verb/undo" hx-target="#session-actions" hx-swap="outerHTML">
      <input type="hidden" name="ticket" value="{{$.Row.URL}}">
      <input type="hidden" name="intent" value="{{$.UndoID}}">
      <input type="hidden" name="verb" value="{{$.UndoVerb}}">
      <button type="submit">Undo</button>
    </form>
    {{- end}}</div>{{end}}
  <div class="verbs{{if .Callout}} callout{{end}}" data-glyph="{{.Row.Glyph}}">
    {{- $s := .}}
    {{- range .Actions}}
    <form method="post" action="/verb" hx-post="/verb" hx-disabled-elt="find button" hx-sync="closest #session-actions:replace" hx-target="#session-actions" hx-swap="outerHTML"{{with .Confirm}} hx-confirm="{{.}}"{{end}}>
      <input type="hidden" name="ticket" value="{{$s.Row.URL}}">
      <input type="hidden" name="from" value="session">
      <input type="hidden" name="return" value="{{$s.TranscriptPath}}">
      <button class="btn" type="submit" name="verb" value="{{.Verb}}"{{with .Key}} data-key="{{.}}"{{end}}{{if .Pending}} disabled{{end}}>{{.Label}}</button>
      {{- if .Pending}}<span class="pending-mark" data-glyph="pending">queued</span>{{end}}
    </form>
    {{- end}}
    {{- if .Row.FixCI}}<button type="button" class="btn" data-key="i" data-show-modal="fix-ci-dialog">Fix CI</button>{{end}}
    {{- with .PRURL}}<a class="btn" href="{{.}}" data-key="o" target="_blank" rel="noopener">Open PR</a>{{end}}
    {{- if .Row.LogPath}}<a class="btn" href="{{.RawPath}}">Open log</a>{{end}}
  </div>
  {{- if .Running}}
  <p class="composer-running" data-glyph="running">Agent is running{{with .Row.Log.Worked.Stats}} · {{.}}{{end}}{{with .Row.Elapsed}} · {{.}}{{end}}</p>
  {{- end}}
  {{- range .PendingMessages}}
  <p class="pending-message" data-glyph="pending"><span class="text-muted">you</span> {{.}}</p>
  {{- end}}
</div>
{{- if .Row.FixCI}}{{template "fixCIDialog" .}}{{end}}
{{- if .ResetComposer}}{{template "sessionComposer" .}}{{end}}{{end}}
{{define "fixCIDialog"}}<dialog id="fix-ci-dialog" class="launch-dialog"{{if .Fragment}} hx-swap-oob="true"{{end}} aria-labelledby="fix-ci-title">
  <form class="launch-form" method="post" action="/verb" hx-post="/verb" hx-disabled-elt="find button" hx-target="#session-actions" hx-swap="outerHTML" data-close-on-success data-reset-on-success data-submit-on-mod-enter>
    <input type="hidden" name="ticket" value="{{.Row.URL}}">
    <input type="hidden" name="from" value="session">
    <input type="hidden" name="return" value="{{.TranscriptPath}}">
    <input type="hidden" name="verb" value="follow-up">
    <header class="launch-head">
      <h2 id="fix-ci-title" class="launch-dialog-title">Fix CI</h2>
      <button type="button" class="btn btn-ghost btn-sm btn-icon" data-close-modal aria-label="Close">{{template "icon" "x"}}</button>
    </header>
    <div class="launch-body">
      <p class="text-muted text-sm">The failed log of each red Actions check is attached when you send.</p>
      <ul class="launch-flight">
        {{- range .Row.RedChecks}}
        <li>{{if .DetailsURL}}<a href="{{.DetailsURL}}" target="_blank" rel="noopener">{{.Name}}</a>{{else}}{{.Name}}{{end}}</li>
        {{- end}}
      </ul>
    </div>
    <div class="launch-foot">
      <div class="composer">
        <label class="sr-only" for="fix-ci-prompt">Prompt</label>
        <textarea id="fix-ci-prompt" name="prompt" rows="6" required>{{.Row.FixCIPrompt}}</textarea>
        <div class="composer-bar">
          {{- $model := .Model}}
          <label class="picker"><span class="sr-only">Model</span><select name="model">
            {{- range .Models}}<option value="{{.}}"{{if eq . $model}} selected{{end}}>{{.}}</option>{{end -}}
          </select></label><span class="sep"></span>
          <label class="picker"><span class="sr-only">Effort</span><select name="effort">
            <option value="">Default effort</option>
            {{- range .Efforts}}<option value="{{.}}">{{.}}</option>{{end -}}
          </select></label>
        </div>
      </div>
      <div class="launch-actions">
        <button type="button" class="btn btn-ghost" data-close-modal>Cancel</button>
        <button type="submit" class="btn btn-primary">Send <kbd>⌘↵</kbd></button>
      </div>
    </div>
  </form>
</dialog>{{end}}
{{define "sessionComposer"}}<div id="session-composer"{{if .ResetComposer}} hx-swap-oob="true"{{end}}>
  {{- if .Row.FollowUpAvailable}}
  <form class="composer" method="post" action="/verb" hx-post="/verb" hx-disabled-elt="find button" hx-target="#session-actions" hx-swap="outerHTML">
    <input type="hidden" name="ticket" value="{{.Row.URL}}">
    <input type="hidden" name="from" value="session">
    <input type="hidden" name="return" value="{{.TranscriptPath}}">
    <input type="hidden" name="verb" value="follow-up">
    <textarea name="prompt" rows="2" data-key="enter"{{if .AwaitingInput}} autofocus{{end}} required placeholder="{{if .AwaitingInput}}Answer the agent's question…{{else if .Running}}Send the running agent a message…{{else}}Send this run a follow-up prompt…{{end}}" aria-label="{{if .AwaitingInput}}reply{{else}}follow-up prompt{{end}}"></textarea>
    <div class="composer-bar">
      {{- $model := .Model}}
      <label class="picker"><span class="sr-only">Model</span><select name="model">
        {{- range .Models}}<option value="{{.}}"{{if eq . $model}} selected{{end}}>{{.}}</option>{{end -}}
      </select></label><span class="sep"></span>
      <label class="picker"><span class="sr-only">Effort</span><select name="effort">
        <option value="">Default effort</option>
        {{- range .Efforts}}<option value="{{.}}">{{.}}</option>{{end -}}
      </select></label><span class="sep"></span>
      <span class="picker" title="{{.Row.Worktree}}">{{template "icon" "lock"}}Worktree</span>
      <button class="btn-send" type="submit" aria-label="{{if .AwaitingInput}}Reply{{else}}Send{{end}}">{{template "icon" "send"}}</button>
    </div>
  </form>
  {{- end}}
</div>{{end}}
{{define "stepStrip"}}{{if .Steps}}<nav id="step-strip" class="flex items-center gap-2 mb-4 overflow-x-auto" aria-label="steps"{{if .StepLive}} hx-get="{{.StepsPath}}" hx-trigger="every 5s" hx-select="#step-strip" hx-swap="outerHTML" hx-sync="this:drop"{{end}}>
  {{- range .Steps}}
  <a class="btn step-cell shrink-0 h-auto min-h-7 py-1 px-3 font-mono" href="{{$.StepPath .}}" {{template "nav" ($.StepPath .)}} title="{{.Model}}"{{if $.IsSelected .}} aria-current="page"{{end}}>
    <span class="glyph glyph-{{.Glyph}}{{if .Live}} glyph-pulse{{end}}" data-glyph="{{.Glyph}}" aria-hidden="true"></span>
    <span>{{.Label}}</span>
    <span class="text-muted">{{with .Wall}}{{.}}{{end}}{{if .PctWeek}} · {{printf "%.1f" .PctWeek}}%{{end}}{{if .Turns}} · {{.Turns}}t{{end}}</span>
  </a>
  {{- end}}
</nav>{{end}}{{end}}
{{define "stackList"}}<ul class="stack-list">
  {{- range .}}
  <li>{{if .Path}}<a class="stack-row" href="{{.Path}}" {{template "nav" .Path}}{{if .Current}} aria-current="page"{{end}}>{{template "stackRow" .}}</a>
  {{- else}}<span class="stack-row">{{template "stackRow" .}}</span>{{end}}</li>
  {{- end}}
</ul>{{end}}
{{define "stackRow"}}
    {{- if .Glyph}}<span class="glyph glyph-{{.Glyph}}" data-glyph="{{.Glyph}}" aria-hidden="true"></span>{{end}}
    <span class="stack-row-ref">{{.Ref}}</span>
    <span class="stack-row-title">{{or .Title .Ref}}</span>
    <span class="stack-row-tail">{{with .Metric}}{{.}}{{else}}{{with .Wave}}wave {{.}}{{end}}{{end}}</span>
    {{- with .Label}}<span class="sr-only">{{.}}</span>{{end}}
{{- end}}
