{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<h1>Launch a feature</h1>
{{if .Features -}}
<p class="page-purpose">Choose a feature to review what would start.</p>
<ul class="flex max-w-3xl flex-col gap-0.5" aria-label="features with launchable work">
  {{range .Features -}}
  <li><a class="launch-pick" href="{{.Path}}" {{template "nav" .Path}}>
    <span class="launch-pick-name">{{.Name}}</span>
    <span class="launch-pick-n">{{.Now}} ready now{{if .OnUnlock}} &middot; {{.OnUnlock}} on unlock{{end}}</span>
  </a></li>
  {{- end}}
</ul>
{{- else -}}
<p class="page-purpose">No feature has work to launch.</p>
{{- end}}
<div id="launch-modal">{{with .Launch}}{{template "launchDialog" .}}{{end}}</div>
{{template "shellEnd" .}}
