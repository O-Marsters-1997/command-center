{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
<li>launch</li>
{{template "shellAction" .}}
{{template "shellContent" .}}
<h1>Launch a feature</h1>
<div id="launch-modal">
{{- if .Launch}}{{template "launchDialog" .Launch -}}
{{- else -}}
<dialog class="launch-dialog launch-dialog-picker" open aria-labelledby="launch-dialog-title">
<header class="launch-head">
<h2 id="launch-dialog-title" class="launch-dialog-title">Launch a feature</h2>
<a class="btn btn-ghost btn-sm btn-icon" href="/" aria-label="Close" {{template "nav" "/"}}>{{template "icon" "x"}}</a>
</header>
<div class="launch-body">
{{if .Features -}}
<ul class="launch-picks" aria-label="features with launchable work">
  {{range .Features -}}
  <li><a class="launch-pick" href="{{.Path}}" {{template "nav" .Path}}>
    {{template "mark" .Project}}
    <span class="launch-pick-name">{{.Name}}</span>
    <span class="launch-pick-n">{{.Now}} ready{{if .OnUnlock}} &middot; {{.OnUnlock}} on unlock{{end}}</span>
    {{template "icon" "chev"}}
  </a></li>
  {{- end}}
</ul>
{{- else -}}
<p class="text-muted">No feature has work to launch.</p>
{{- end}}
</div>
</dialog>
{{- end}}
</div>
{{template "shellEnd" .}}
