{{define "board" -}}
<table id="board" hx-get="{{.BoardPath}}" hx-trigger="every {{.BoardPollSeconds}}s" hx-swap="outerHTML">
  <tr>
    <th></th><th>state</th><th>ref</th><th>ticket</th><th>stack</th>
    <th>checks</th><th>pr</th><th>elapsed</th><th>spend</th><th>verbs</th>
  </tr>
  {{range $section := .Sections}}
  <tbody data-section="{{$section.Key}}" aria-labelledby="section-{{$section.Key}}">
    <tr class="section-head"><th id="section-{{$section.Key}}" colspan="10">{{$section.Title}} <span class="section-count">{{len $section.Rows}}</span></th></tr>
    {{range $section.Rows}}{{template "row" (slot . $.RepoScope $.FeatureScope)}}{{end}}
  </tbody>
  {{end}}
</table>
{{- end}}

{{define "row"}}
  <tr class="group">
    <td>
      {{- $row := .}}
      {{- range .Verbs}}
      {{- if eq . $row.LaunchVerb}}
      <input type="checkbox" form="launch" name="ticket" value="{{$row.URL}}"{{if $row.Checked}} checked{{end}}
        hx-get="{{$row.TogglePath}}" hx-push-url="{{$row.TogglePush}}" hx-target="#board" hx-swap="outerHTML">
      {{- end}}
      {{- end -}}
    </td>
    <td>
      <span class="glyph glyph-{{.Glyph}}{{if .Alive}} glyph-pulse{{end}}">{{.State}}</span>
      {{- if .Draft}} <mark class="flag" title="draft: {{.DraftReason}}">draft</mark>{{end}}
      {{- if .BaseVerdict}} <mark class="flag" title="base verdict: {{.BaseVerdict}}">base {{.BaseVerdict}}</mark>{{end}}
      {{- if .Warning}} <mark class="flag flag-warning" title="{{.Warning}}">⚠ warning</mark>{{end}}
      {{- range .PendingVerbs}} · {{.}} queued{{end}}
    </td>
    <td>
      <a href="{{.SessionPath}}" hx-get="{{.SessionPath}}" hx-select="#main" hx-target="#main" hx-swap="outerHTML" hx-push-url="true">{{.Ticket}}</a>
      {{- if and .Scope (ne .Repo .Scope)}} <span class="text-muted text-[0.85em]">{{.Repo}}</span>{{end}}
      {{- if and .FeatureScope (ne .Feature .FeatureScope)}} <span class="text-muted text-[0.85em]">{{.Feature}}</span>{{end}}
    </td>
    <td>
      {{- if .RedChecks}}
      <div class="text-muted text-[0.85em]">required check failed: {{range $i, $c := .RedChecks}}{{if $i}}, {{end}}{{if $c.DetailsURL}}<a href="{{$c.DetailsURL}}" target="_blank" rel="noopener">{{$c.Name}}</a>{{else}}{{$c.Name}}{{end}}{{end}}</div>
      {{- else if .Reason}}<div class="text-muted text-[0.85em]">{{.Reason}}</div>{{end}}
      <div>{{if .Title}}{{.Title}}{{else}}untitled{{end}}</div>
      {{- if .After}}<div class="text-muted text-[0.85em]">after {{range $i, $r := .After}}{{if $i}}, {{end}}{{$r}}{{end}}</div>{{end}}
      {{- if .Unlocks}}<div class="text-muted text-[0.85em]">unlocks {{range $i, $r := .Unlocks}}{{if $i}}, {{end}}{{$r}}{{end}}</div>{{end}}
    </td>
    <td>{{.Stack}}</td>
    <td>
      {{- if .Checks}}
      <span class="meter"><span class="meter-fill" style="width: {{percent .ChecksPassed (len .Checks)}}%"></span></span>
      {{.ChecksPassed}}/{{len .Checks}}
      {{- else}}no checks{{end}}
    </td>
    <td>{{if .PRNumber}}#{{.PRNumber}} {{.PRState}}{{else}}no pr{{end}}</td>
    <td>
      {{- if .Elapsed}}
      <span class="meter"><span class="meter-fill" style="width: {{.ElapsedPercent}}%"></span></span>
      {{.Elapsed}}
      {{- else}}not started{{end}}
    </td>
    <td>
      {{- if gt .SpendPctWeek 0.0}}
      <span class="flex h-[0.4rem] w-24 overflow-hidden rounded-full bg-track" title="{{printf "%.2f" .SpendPctWeek}}% week (agent {{printf "%.2f" .AgentPctWeek}}, resolve {{printf "%.2f" .ResolvePctWeek}}, follow-up {{printf "%.2f" .FollowUpPctWeek}})">
        <span class="segbar-segment" data-kind="agent" style="flex-grow: {{.AgentPctWeek}}"></span>
        <span class="segbar-segment" data-kind="resolve" style="flex-grow: {{.ResolvePctWeek}}"></span>
        <span class="segbar-segment" data-kind="follow_up" style="flex-grow: {{.FollowUpPctWeek}}"></span>
      </span>
      {{printf "%.2f" .SpendPctWeek}}% week{{if .TicketOpen}} <span class="text-muted text-[0.85em]">open</span>{{end}}
      {{- else if .SpendSettled}}${{printf "%.2f" .SpendUSD}}
      {{- else if .SpendTokens}}{{.SpendTokens}} tok
      {{- else}}no spend{{end}}
    </td>
    <td class="opacity-35 transition-[opacity] duration-[120ms] ease-[ease-in-out] motion-reduce:transition-none group-hover:opacity-100 group-focus-within:opacity-100">
      {{- $row := .}}
      {{- range .Verbs}}
      {{- if eq . $row.LaunchVerb}}
      {{- else if eq . $row.FollowUpVerb -}}
      {{- else}}
      <form method="post" action="/verb" hx-post="{{or $row.VerbPath "/verb"}}" hx-target="#board" hx-swap="outerHTML"{{with confirmation . $row.Row}} hx-confirm="{{.}}"{{end}}>
        <input type="hidden" name="ticket" value="{{$row.URL}}">
        <button type="submit" name="verb" value="{{.}}">
          {{- .}}{{if eq . $row.CancelVerb}} launch ({{$row.CancelCount}} tickets){{end -}}
        </button>
      </form>
      {{- end}}
      {{- end -}}
    </td>
  </tr>
{{end}}

{{define "boardForm" -}}
<!-- Empty, and outside the table on purpose: a launch authorises a whole slice at once, so its
     checkboxes sit in the rows and join this form by form="launch". Wrapping the table in it
     instead would nest the per-row verb forms inside it, which HTML forbids. -->
<form id="launch" method="post" action="/launch/open" hx-post="/launch/open" hx-target="#launch-modal" hx-swap="innerHTML"></form>
{{template "board" .}}
<button type="submit" form="launch">launch selected</button>
{{- end}}
