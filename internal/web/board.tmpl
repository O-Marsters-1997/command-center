{{define "featureHead" -}}
<header class="feature-head">
  <h1>{{.FeatureScope}}</h1>
  <p>{{with .ProjectScope}}{{.}} · {{end}}{{if .Launched.IsSome}}launched {{template "age" .Launched.Unwrap}} · {{end}}{{.TicketCount}} {{if eq .TicketCount 1}}ticket{{else}}tickets{{end}} in {{.WaveCount}} {{if eq .WaveCount 1}}wave{{else}}waves{{end}} · <kbd>V</kbd> switches view</p>
  <div class="feature-stats">
    <span class="segbar">
      {{- range .Sections}}<span class="segbar-segment" data-glyph="{{.Glyph}}" style="flex-grow: {{len .Rows}}"></span>{{end -}}
    </span>
    {{- range .Sections}}
    <span class="glyph glyph-{{.Glyph}}">{{len .Rows}} {{.Stat}}</span>
    {{- end}}
  </div>
</header>
{{- end}}

{{define "featureLaunch" -}}
<a class="btn" href="/f/{{.FeatureScope | pathEscape}}/launch" data-key="c" {{template "nav" (printf "/f/%s/launch" (.FeatureScope | pathEscape))}}>Launch{{if .LaunchCount}} · {{.LaunchCount}}{{end}}</a>
{{- end}}

{{define "board" -}}
<div id="board" hx-get="{{.BoardPath}}" hx-trigger="every {{.BoardPollSeconds}}s" hx-sync="this:drop" hx-swap="outerHTML">
  {{- range $section := .Sections}}
  <section data-section="{{$section.Key}}" aria-labelledby="section-{{$section.Key}}">
    <h2 id="section-{{$section.Key}}" class="flex h-[34px] items-center gap-2 border-b border-border-soft px-2 text-sm font-medium text-fg-2">{{$section.Title}} <span class="section-count">{{len $section.Rows}}</span></h2>
    {{- range $section.Rows}}
    <a class="grid min-h-[46px] grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 border-b border-border-soft px-2 py-1 text-inherit no-underline hover:bg-surface-2 md:grid-cols-[auto_4rem_minmax(0,1fr)_9rem_3.5rem_3.5rem_7rem]" href="{{.SessionPath}}" data-ref="{{.Ticket}}" {{template "nav" .SessionPath}}>
      <span class="glyph{{if .Alive}} glyph-pulse{{end}}" data-glyph="{{.Glyph}}" title="{{.Label}}"></span>
      <span class="hidden font-mono text-xs text-meta md:inline">{{.Ticket}}</span>
      <span class="grid min-w-0">
        <b class="truncate text-sm font-medium">{{if .Title}}{{.Title}}{{else}}untitled{{end}}</b>
        <span class="truncate text-xs text-muted">{{.Detail}}</span>
      </span>
      <span class="hidden truncate text-xs text-fg-2 md:block">
        {{- if eq $.Context "feature"}}<span class="chip max-w-full border-border-soft text-muted">{{template "mark" .Mark}}<span class="truncate">{{or .Feature .Repo}}</span></span>
        {{- else}}{{.Repo}}{{end -}}
      </span>
      <span class="hidden font-mono text-xs md:inline">{{if .ChecksTotal}}{{.ChecksPassed}}/{{.ChecksTotal}}{{else}}—{{end}}</span>
      <span class="hidden font-mono text-xs md:inline">{{if .PRNumber}}#{{.PRNumber}}{{else}}—{{end}}</span>
      <span class="justify-self-end font-mono text-xs text-fg-2">
        {{- if .Elapsed}}{{.Elapsed}}
        {{- else if gt .SpendPctWeek 0.0}}{{printf "%.2f" .SpendPctWeek}}% week
        {{- else if .SpendTokens}}{{.SpendTokens}} tok
        {{- else}}—{{end -}}
      </span>
    </a>
    {{- end}}
  </section>
  {{- else}}
  <p class="px-2 py-3 text-sm text-muted">No tickets match this view.</p>
  {{- end}}
</div>
{{- end}}
