{{define "detail"}}<td colspan="10">
  <dl class="m-0 grid grid-cols-[max-content_1fr] gap-x-4">
    <dt class="text-muted">base sha</dt><dd class="m-0">{{.BaselineSHA}}</dd>
    <dt class="text-muted">worktree</dt><dd class="m-0">{{if .Worktree}}{{.Worktree}}{{else}}no worktree has been cut{{end}}</dd>
    <dt class="text-muted">elapsed</dt><dd class="m-0">{{if .Elapsed}}{{.Elapsed}}{{else}}not started{{end}}</dd>
    <dt class="text-muted">checks</dt>
    <dd class="m-0">
      {{- range .Checks}}<div>{{if .DetailsURL}}<a href="{{.DetailsURL}}" target="_blank" rel="noopener">{{.Name}}</a>{{else}}{{.Name}}{{end}}: {{.Status}}{{with .Conclusion}} {{.}}{{end}}</div>{{else}}no checks{{end -}}
    </dd>
    {{if .Draft}}<dt class="text-muted">draft</dt><dd class="m-0">{{.DraftReason}}</dd>{{end}}
    {{if .BaseVerdict}}<dt class="text-muted">base verdict</dt><dd class="m-0">{{.BaseVerdict}}</dd>{{end}}
    {{if .Warning}}<dt class="text-muted">warning</dt><dd class="m-0">{{.Warning}}</dd>{{end}}
  </dl>
  <div class="run-log">
    <div class="run-log-header flex flex-wrap items-center gap-2">
      <span class="run-log-path font-medium">{{.Log.Path}}</span>
      {{if .Log.Streaming}}<span class="pill" data-tone="live"><span class="pill-pulse"></span>streaming</span>
      {{- else}}<span class="pill"><span class="pill-ring"></span>ended</span>{{end}}
      {{- with .Log.Outcome}}
      <span class="run-log-outcome text-muted">{{.}}</span>
      {{- end}}
      <nav class="log-filters flex gap-2">
        {{- range .Log.Filters}}<a href="{{.Path}}" class="px-1{{if .Active}} active font-semibold{{end}}"{{if .Active}} aria-current="true"{{end}}>{{.Label}}</a>{{end -}}
      </nav>
      {{- with .Log.Jump.Path}}
      <a href="{{.}}" class="jump-first-fail ml-auto">{{$.Log.Jump.Label}}</a>
      {{- end}}
    </div>
    <p class="run-log-meta text-muted">{{.Log.Lines}} lines · {{.Log.PhaseCount}} phases</p>
    <div class="run-thread">
      {{- if .Log.PhaseCount}}
      <details class="worked"{{if .Log.Worked.Open}} open{{end}}>
        <summary><span class="worked-spark" aria-hidden="true">✻</span> {{.Log.Worked.Label}}{{with .Log.Worked.Stats}} <span class="worked-stats">{{.}}</span>{{end}}</summary>
      </details>
      {{- end}}
      {{- with .Log.Strip}}
      <nav class="phase-strip flex" aria-label="Phases">
        {{- range .}}<a href="{{.Path}}" class="phase-seg" style="flex: {{.Weight}}"{{with .Title}} title="{{.}}"{{end}}{{if .Active}} aria-current="true"{{end}}><span class="phase-bar"></span><span class="phase-name"><b>{{.Label}}</b>{{if .Failed}}<span class="phase-dot" aria-label="a check failed"></span>{{end}}<span>{{.Duration}}</span></span></a>{{end -}}
      </nav>
      {{- end}}
      {{- with .Log.Readout.Metrics}}
      <div class="readout flex flex-wrap items-baseline">
        {{- range .}}<span class="metric"{{if .Failed}} data-tone="stop"{{end}}><span class="metric-label">{{.Label}}</span> <span class="metric-value">{{.Value}}{{with .Note}} <small>{{.}}</small>{{end}}</span></span>{{end}}
        {{- with $.Log.Readout.Insight}}<p class="readout-insight"><b>{{$.Log.Readout.Lead}}</b> {{.}}{{with $.Log.Readout.ClearPath}} <a href="{{.}}" class="readout-clear">Whole run</a>{{end}}</p>{{end}}
      </div>
      {{- end}}
      <div class="run-work">
        {{- range .Log.Phases}}
        <section class="phase">
          <header class="phase-head flex items-baseline gap-2">
            <span class="phase-skill">{{if .Skill}}{{.Skill}}{{else}}start{{end}}</span>{{with .Note}}<span class="phase-note">{{.}}</span>{{end}}
            <span class="phase-rule"></span>
            <span class="phase-at">{{.At}}</span>
          </header>
          {{- range .Items}}
          {{if eq .Kind "say"}}{{raw .Line}}{{else if eq .Kind "calls"}}<details class="fold"{{if .Group.Open}} open{{end}}><summary>{{.Group.Summary}}{{with .Group.FailNote}} <span class="fold-fail">· {{.}}</span>{{end}}</summary><div class="fold-body">{{range .Group.Lines}}{{raw .}}{{end}}</div></details>{{else}}<span id="first-fail"></span>{{end}}
          {{- end}}
        </section>
        {{- end}}
        <div class="run-log-live" hx-ext="sse" sse-connect="{{.Log.StreamPath}}" sse-swap="message" sse-close="end" hx-swap="beforeend"></div>
      </div>
      {{- with .Log.Final}}
      <div class="run-final">{{raw .}}</div>
      {{- end}}
      {{- if .Log.Changed.Count}}
      <p class="changed-files flex items-center gap-2"><span class="changed-files-label">{{.Log.Changed.Count}} changed {{if eq .Log.Changed.Count 1}}file{{else}}files{{end}}</span>{{if or .Log.Changed.Added .Log.Changed.Removed}} <span class="diff-plus">+{{.Log.Changed.Added}}</span> <span class="diff-minus">−{{.Log.Changed.Removed}}</span>{{end}}</p>
      {{- end}}
    </div>
  </div>
  {{- if .ContextCurve.Series}}
  <div class="context-curve mt-3">
    <p class="text-muted mb-1">context tokens per request</p>
    <svg width="{{.ContextCurve.Width}}" height="{{.ContextCurve.Height}}" viewBox="0 0 {{.ContextCurve.Width}} {{.ContextCurve.Height}}" role="img">
      {{$curve := .ContextCurve}}
      {{range $curve.Ticks}}<line class="chart-grid" x1="32" x2="{{$curve.Width}}" y1="{{.Y}}" y2="{{.Y}}"></line>
      <text class="chart-tick" x="28" y="{{.Y}}" dy="0.32em" text-anchor="end">{{.Label}}</text>
      {{end -}}
      {{range $curve.Series}}<path class="chart-line {{.Class}}" d="{{.Path}}"><title>{{.Title}}</title></path>
      {{end -}}
    </svg>
    <div class="context-curve-legend flex gap-3 mt-1">
      {{range .ContextCurve.Series}}<span class="chart-legend"><span class="chart-legend-swatch {{.Class}}"></span>{{.Label}}</span>{{end}}
    </div>
  </div>
  {{- end}}
  <form method="post" action="/ticket" class="edit-ticket mt-3 flex flex-col gap-2">
    <input type="hidden" name="ticket" value="{{.URL}}">
    <label class="flex items-center gap-2"><span class="text-muted">branch</span><input type="text" name="branch" value="{{.Branch}}" required class="flex-1"></label>
    <fieldset class="m-0 flex flex-col gap-1 border-0 p-0">
      <legend class="text-muted">blocked by</legend>
      {{- range .BlockedBy}}
      <input type="text" name="blocked_by" value="{{.}}" aria-label="blocked by">
      {{- end}}
      <input type="text" name="blocked_by" placeholder="add a blocker URL" aria-label="add a blocker">
    </fieldset>
    <button type="submit" class="self-end">save</button>
  </form>
  {{- if .FollowUpAvailable}}
  <form method="post" action="/verb" hx-post="{{or .VerbPath "/verb"}}" hx-target="#board" hx-swap="outerHTML" class="follow-up mt-3 flex flex-col gap-2">
    <input type="hidden" name="ticket" value="{{.URL}}">
    <input type="hidden" name="verb" value="{{.FollowUpVerb}}">
    <textarea name="prompt" rows="3" placeholder="Send this run a follow-up prompt…" class="w-full"></textarea>
    <button type="submit" class="self-end">send</button>
  </form>
  {{- end}}
</td>
{{end}}
