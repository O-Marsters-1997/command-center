{{define "logline"}}{{if eq .Kind "say"}}<div class="line line-say prose">{{range .Blocks}}{{if .List}}<ul>{{range .Items}}<li>{{template "logspans" .}}</li>{{end}}</ul>{{else}}{{range .Items}}<p>{{template "logspans" .}}</p>{{end}}{{end}}{{end}}</div>{{else if eq .Kind "skill"}}<div class="line line-skill"><span class="line-label">skill</span> {{.Verb}}{{with .Arg}} · {{.}}{{end}}</div>{{else if eq .Kind "record"}}<div class="line line-record"><span class="line-label">{{.Verb}}</span>{{with .Arg}} {{.}}{{end}}</div>{{else}}<div class="line line-{{.Kind}} call"{{if .Failed}} data-glyph="failed"{{end}}{{if .Anchor}} id="first-fail"{{else if .CallID}} id="call-{{.CallID}}"{{end}}{{if .Replace}} hx-swap-oob="true"{{end}}><div class="call-head"><span class="call-verb">{{.Verb}}</span>{{with .Arg}}<code class="call-arg">{{.}}</code>{{end}}<span class="call-res">{{if and (not .Failed) (or .Added .Removed)}}<span class="diff-plus">+{{.Added}}</span> <span class="diff-minus">−{{.Removed}}</span>{{else}}{{.Result}}{{end}}</span></div>{{if .Fold}}<details class="call-fold"{{if .Open}} open{{end}}><summary>output</summary><pre class="call-out">{{.Output}}</pre></details>{{else}}{{with .Output}}<pre class="call-out">{{.}}</pre>{{end}}{{end}}{{with .Diff}}<div class="call-diff">{{range .}}<div class="diff-row diff-{{.Op}}">{{.Text}}</div>{{end}}</div>{{end}}</div>{{end}}{{end}}
{{define "logspans"}}{{range .}}{{if .Code}}<code class="code-chip">{{.Text}}</code>{{else if .Strong}}<strong>{{.Text}}</strong>{{else}}{{.Text}}{{end}}{{end}}{{end}}
