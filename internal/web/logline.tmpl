{{define "logline"}}{{if eq .Shape "say"}}<div class="line line-say prose">{{range .Blocks}}{{if .List}}<ul>{{range .Items}}<li>{{template "logspans" .}}</li>{{end}}</ul>{{else}}{{range .Items}}<p>{{template "logspans" .}}</p>{{end}}{{end}}{{end}}</div>{{else if eq .Shape "skill"}}<div class="line line-skill">{{template "skillPill" .Verb}}{{with .Arg}} {{.}}{{end}}</div>{{else if eq .Shape "record"}}<div class="line line-record{{if .Checks}} line-checks{{end}}">{{with .Result}}<span class="line-time font-mono">{{.}}</span> {{end}}<span class="line-label">{{.Verb}}</span>{{with .Arg}} {{if $.Href}}<a href="{{$.Href}}" target="_blank" rel="noopener">{{.}}</a>{{else}}{{.}}{{end}}{{end}}{{with .Checks}}<ul class="check-grid">{{range .}}<li data-glyph="{{.Glyph}}"><span class="check-name">{{.Name}}</span>{{with .Elapsed}}<span class="check-elapsed font-mono">{{.}}</span>{{end}}{{if and .Failed .DetailsURL}}<a class="check-output" href="{{.DetailsURL}}" target="_blank" rel="noopener">output</a>{{end}}</li>{{end}}</ul>{{end}}</div>{{else}}<details class="line line-{{.Kind}} call"{{if .Failed}} data-glyph="failed"{{end}}{{if .Anchor}} id="first-fail"{{else if .CallID}} id="call-{{.CallID}}"{{end}}{{if .Replace}} hx-swap-oob="true"{{end}}><summary class="call-head"><span class="call-verb">{{.Verb}}</span>{{with .Arg}}<code class="call-arg">{{.}}</code>{{end}}<span class="call-res">{{if and (not .Failed) (or .Added .Removed)}}<span class="diff-plus">+{{.Added}}</span> <span class="diff-minus">−{{.Removed}}</span>{{else}}{{.Result}}{{end}}</span></summary><div class="call-body">{{with .Arg}}<pre class="call-out call-in">{{.}}</pre>{{end}}{{with .Output}}<pre class="call-out">{{.}}</pre>{{end}}{{with .Diff}}<div class="call-diff">{{range .}}<div class="diff-row diff-{{.Op}}">{{.Text}}</div>{{end}}</div>{{end}}</div></details>{{end}}{{end}}
{{define "logspans"}}{{range .}}{{if .Code}}<code class="code-chip">{{.Text}}</code>{{else if .Strong}}<strong>{{.Text}}</strong>{{else}}{{.Text}}{{end}}{{end}}{{end}}
{{define "skillPill"}}<span class="skill-pill">{{template "icon" "zap"}}{{.}}</span>{{end}}
