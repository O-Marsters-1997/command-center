{{define "logline"}}{{if eq .Shape "say"}}<div class="line line-say prose">{{range .Blocks}}{{if .List}}<ul>{{range .Items}}<li>{{template "logspans" .}}</li>{{end}}</ul>{{else}}{{range .Items}}<p>{{template "logspans" .}}</p>{{end}}{{end}}{{end}}</div>{{else if eq .Shape "skill"}}<div class="line line-skill"><span class="line-label">skill</span> {{.Verb}}{{with .Arg}} · {{.}}{{end}}</div>{{else if eq .Shape "record"}}<div class="line line-record">{{with .Result}}<span class="line-time font-mono text-muted">{{.}}</span> {{end}}<span class="line-label">{{.Verb}}</span>{{with .Arg}} {{if $.Href}}<a href="{{$.Href}}" target="_blank" rel="noopener">{{.}}</a>{{else}}{{.}}{{end}}{{end}}{{with .Checks}}<ul class="check-grid">{{range .}}<li{{if eq .Status "COMPLETED"}}{{if or (eq .Conclusion "SUCCESS") (eq .Conclusion "SKIPPED")}} data-glyph="done"{{else}} data-glyph="failed"{{end}}{{else}} data-glyph="running"{{end}}><span class="check-name">{{.Name}}</span>{{with .Elapsed}}<span class="check-elapsed font-mono">{{.}}</span>{{end}}{{if and (eq .Status "COMPLETED") (ne .Conclusion "SUCCESS") (ne .Conclusion "SKIPPED") .DetailsURL}}<a class="check-output" href="{{.DetailsURL}}" target="_blank" rel="noopener">output</a>{{end}}</li>{{end}}</ul>{{end}}</div>{{else}}<div class="line line-{{.Kind}} call"{{if .Failed}} data-glyph="failed"{{end}}{{if .Anchor}} id="first-fail"{{else if .CallID}} id="call-{{.CallID}}"{{end}}{{if .Replace}} hx-swap-oob="true"{{end}}><div class="call-head"><span class="call-verb">{{.Verb}}</span>{{with .Arg}}<code class="call-arg">{{.}}</code>{{end}}<span class="call-res">{{if and (not .Failed) (or .Added .Removed)}}<span class="diff-plus">+{{.Added}}</span> <span class="diff-minus">−{{.Removed}}</span>{{else}}{{.Result}}{{end}}</span></div>{{if .Fold}}<details class="call-fold"{{if .Open}} open{{end}}><summary>output</summary><pre class="call-out">{{.Output}}</pre></details>{{else}}{{with .Output}}<pre class="call-out">{{.}}</pre>{{end}}{{end}}{{with .Diff}}<div class="call-diff">{{range .}}<div class="diff-row diff-{{.Op}}">{{.Text}}</div>{{end}}</div>{{end}}</div>{{end}}{{end}}
{{define "logspans"}}{{range .}}{{if .Code}}<code class="code-chip">{{.Text}}</code>{{else if .Strong}}<strong>{{.Text}}</strong>{{else}}{{.Text}}{{end}}{{end}}{{end}}
