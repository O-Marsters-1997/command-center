{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
<a class="btn btn-primary" href="/f/{{.FeatureScope | pathEscape}}/launch" data-key="c" hx-get="/f/{{.FeatureScope | pathEscape}}/launch" hx-select="#main" hx-target="#main" hx-swap="outerHTML" hx-push-url="true">Launch</a>
{{template "shellContent" .}}
<nav class="pill-tabs" aria-label="feature views">
  <a class="pill-tab" href="/f/{{.FeatureScope | pathEscape}}" aria-current="page">Board</a>
  <a class="pill-tab" href="/f/{{.FeatureScope | pathEscape}}/graph" data-key="v">Graph</a>
</nav>
{{template "featureHead" .}}
{{template "boardForm" .}}
<div id="launch-modal">{{if .Launch.IsSome}}{{template "launchDialog" .Launch.Unwrap}}{{end}}</div>
{{template "shellEnd" .}}
