{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
<a class="btn btn-primary" href="/f/{{.FeatureScope | pathEscape}}/launch" data-key="c" {{template "nav" (printf "/f/%s/launch" (.FeatureScope | pathEscape))}}>Launch</a>
{{template "shellContent" .}}
<nav class="pill-tabs" aria-label="feature views">
  <a class="pill-tab" href="/f/{{.FeatureScope | pathEscape}}" {{template "nav" (printf "/f/%s" (.FeatureScope | pathEscape))}} aria-current="page">Board</a>
  <a class="pill-tab" href="/f/{{.FeatureScope | pathEscape}}/graph" data-key="v" {{template "nav" (printf "/f/%s/graph" (.FeatureScope | pathEscape))}}>Graph</a>
</nav>
{{template "featureHead" .}}
{{template "boardForm" .}}
<div id="launch-modal">{{with .Launch}}{{template "launchDialog" .}}{{end}}</div>
{{template "shellEnd" .}}
