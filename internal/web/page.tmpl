{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{if eq .View "graph"}}<a href="/?view=board{{if .FeatureScope}}&feature={{.FeatureQuery}}{{end}}">board</a>{{else}}<a href="/?view=graph{{if .FeatureScope}}&feature={{.FeatureQuery}}{{end}}">graph</a>{{end}}
{{template "scopeActions" .}}
{{template "shellContent" .}}
{{template "bandStatic" .}}
{{if eq .View "graph"}}
<!-- noShadowDOM() is cc-graph's first statement (ADR 1), so this fallback content is what a
     Go-only build with no Node -- assets/dist/graph.js never built, the script below 404s --
     renders: a custom element the browser never upgrades still shows its light-DOM children. -->
<cc-graph>
  <p class="banner ribbon" data-glyph="pending" role="status">
    the dependency graph needs the built assets: run `just assets`, or switch to the board view.
  </p>
</cc-graph>
<script type="module" src="/assets/dist/graph.js"></script>
{{else}}
<!-- Empty, and outside the table on purpose: a launch authorises a whole slice at once, so its
     checkboxes sit in the rows and join this form by form="launch". Wrapping the table in it
     instead would nest the per-row verb forms inside it, which HTML forbids. -->
<form id="launch" method="post" action="/launch/open" hx-post="/launch/open" hx-target="#launch-modal" hx-swap="innerHTML"></form>
{{template "board" .}}
<button type="submit" form="launch">launch selected</button>
{{end}}
<div id="launch-modal"></div>
{{template "shellEnd" .}}
