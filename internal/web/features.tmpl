{{define "repoResults" -}}
{{with .SearchError}}
<p class="banner ribbon mb-2" data-glyph="failed" role="status">gh search failed: {{.}}</p>
{{end}}
<table class="w-full max-w-3xl">
  {{range .Rows}}
  <tr>
    <td><a href="{{.Path}}">{{.FullName}}</a></td>
    <td>{{if .Tracked}}<span class="glyph glyph-done">ready</span>{{else}}<span class="text-muted">not tracked</span>{{with .RefusedBranch}} <span class="glyph glyph-failed text-xs">will be refused: default branch is <code>{{.}}</code></span>{{end}}{{end}}</td>
    <td>{{if not .Tracked}}<a href="{{.Path}}">track &rarr;</a>{{end}}</td>
  </tr>
  {{else}}
  <tr><td colspan="3" class="text-muted">no repos match.</td></tr>
  {{end}}
</table>
{{- end}}

{{define "importRefusal" -}}
{{with .}}
<p class="banner ribbon mb-2" data-glyph="failed" role="status">
  import of {{.Feature}} refused {{.Age}}. {{.Message}}
</p>
{{end}}
{{- end}}

{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<h1 class="mb-3">REPOS</h1>
{{template "importRefusal" .LastImportError}}
<input type="search" name="q" placeholder="search repos" autocomplete="off" aria-label="search repos"
  class="block w-full max-w-3xl border border-border rounded px-3 py-2 text-lg mb-1"
  hx-get="/features/search" hx-trigger="input changed delay:300ms" hx-target="#repo-results" hx-swap="innerHTML">
<p class="text-muted mb-3">Search runs as this box's gh identity.</p>
<div id="repo-results">
{{template "repoResults" .Results}}
</div>
{{template "shellEnd" .}}
