{{define "nav"}}hx-get="{{.}}" hx-select="#main" hx-target="#main" hx-swap="outerHTML" hx-push-url="true"{{end}}

{{define "navItem"}}<a class="sidebar-item" href="{{.Path}}" data-key="{{.Key}}" {{template "nav" .Path}}{{if .Current}} aria-current="page"{{end}}>{{template "icon" .Icon}}<span>{{.Label}}</span>{{with .Badge}}<span class="sidebar-count{{if $.Warn}} sidebar-count-warn{{end}}">{{.}}</span>{{end}}</a>{{end}}

{{define "flash"}}<p class="banner ribbon" data-glyph="failed">{{.}}</p>{{end}}

{{define "age"}}{{if .Stamp}}<time datetime="{{.Stamp}}">{{.Age}}</time>{{else}}{{.Age}}{{end}}{{end}}

{{define "notices" -}}
<div id="notices">
  {{- range .RefusedRepos}}
  <p class="banner ribbon" data-glyph="failed" role="status">
    <a href="{{.Path}}">{{.Name}}</a> is refused{{with .Reason}}: {{.}}{{end}}
  </p>
  {{- end}}
  {{- if .SpendPaused.IsSome}}
  <p class="banner ribbon" data-glyph="pending" role="status">
    spawning paused: five-hour usage is {{.SpendPaused.Unwrap.Pct}}%, at or above the spend_limit_5h of {{.SpendPaused.Unwrap.Limit}}%.
  </p>
  {{- end}}
</div>
{{- end}}

{{define "docHead" -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"responseHandling":[{"code":"204","swap":false},{"code":"422","swap":true,"error":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":false,"error":true},{"code":"...","swap":true}]}'>
<title>{{.PageTitle}}</title>
<link rel="stylesheet" href="/assets/app.css">
<script src="/assets/htmx.min.js"></script>
<script src="/assets/sse.min.js"></script>
<script type="module" src="/assets/dist/keys.js"></script>
<script type="module" src="/assets/dist/glue.js"></script>
</head>
{{- end}}

{{define "skipLink" -}}
<a class="absolute left-[-100vw] px-[0.6rem] py-[0.35rem] bg-surface focus:left-2 focus:top-2" href="#main">skip to content</a>
{{- end}}

{{define "shellStart" -}}
{{template "docHead" .}}
<body>
{{template "skipLink" .}}
<div class="app" hx-select-oob="#sidebar-head,#sidebar-nav">
{{template "sidebar" .}}
<div class="pane">
{{template "notices" .}}
<div id="flash" aria-live="polite"></div>
<main id="main"{{if .Home}} data-home data-desktop-target="{{.Target}}"{{end}}>
<header class="topbar">
  <a class="back" href="/" {{template "nav" "/"}}>&lsaquo; Back</a>
  <ol class="crumbs">
{{- end}}

{{define "shellAction" -}}
  </ol>
  <div class="topbar-action">
{{- end}}

{{define "shellContent" -}}
  </div>
</header>
<div class="content">
{{- end}}

{{define "shellEnd" -}}
</div>
</main>
</div>
</div>
<div id="toast" class="toast" role="status"></div>
</body>
</html>
{{- end}}

{{define "crumbLabel" -}}
{{if .Project.IsSome}}{{with .Project.Unwrap}}<span class="avatar" data-hue="{{.Hue}}" aria-hidden="true">{{.Initial}}</span> {{end}}{{end}}{{if .Mono}}<span class="font-mono">{{.Label}}</span>{{else}}{{.Label}}{{end}}
{{- end}}

{{define "scopeCrumbs" -}}
{{range .Crumbs}}<li>{{if .Path}}<a href="{{.Path}}" {{template "nav" .Path}}>{{template "crumbLabel" .}}</a>{{else}}{{template "crumbLabel" .}}{{end}}</li>
{{end -}}
{{- end}}

{{define "keySheet" -}}
<dialog id="key-sheet" class="key-sheet" aria-labelledby="key-sheet-title">
  <form method="dialog" class="key-sheet-head">
    <h2 id="key-sheet-title">Keyboard shortcuts</h2>
    <button type="submit" class="btn btn-ghost btn-sm">Close</button>
  </form>
  <div class="key-sheet-body">
    {{range .Keymap}}<h3 class="key-group">{{.Title}}</h3>
    <dl class="key-list">
      {{range .Rows}}<div class="key-row"><dt><kbd>{{.Keys}}</kbd></dt><dd>{{.Does}}</dd></div>
      {{end}}
    </dl>
    {{end}}
  </div>
</dialog>
{{- end}}

{{define "sidebar" -}}
<aside class="sidebar" id="sidebar" aria-label="sections">
  <div class="sidebar-head" id="sidebar-head">
    <a class="sidebar-brand" href="/" data-key="g h" {{template "nav" "/"}}><span class="sidebar-mark" aria-hidden="true">{{template "icon" "term"}}</span><b>{{with .Workspace}}{{.}}{{else}}Command Centre{{end}}</b></a>
    {{with .Chrome.Launch}}<a class="btn btn-ghost btn-sm btn-icon" href="{{.Path}}" data-key="{{.Key}}" aria-label="Launch a feature" title="Launch a feature  C" {{template "nav" .Path}}{{if .Current}} aria-current="page"{{end}}>{{template "icon" "plus"}}</a>{{end}}
  </div>
  <nav class="sidebar-nav" id="sidebar-nav">
    {{range .Nav}}{{template "navItem" .}}
    {{end}}
  </nav>
  <details class="scope-menu mx-2" data-scope-menu>
    <summary class="flex min-h-7 cursor-pointer items-center gap-2 px-2">{{if .ProjectScope}}<span class="avatar" data-hue="{{.ProjectHue}}" aria-hidden="true">{{.ProjectInitial}}</span> {{.ProjectScope}}{{else if .RepoScope}}{{.RepoScope}}{{else}}All projects · {{.LiveAgents}} running{{end}}</summary>
    <nav class="flex flex-col gap-0.5" aria-label="scope">
      <a class="rail-link" href="/tickets" data-key="g 0" {{template "nav" "/tickets"}}{{if not (or .ProjectScope .RepoScope)}} aria-current="true"{{end}}>All projects</a>
      {{range .ScopeMenu}}<a class="rail-link" href="{{.Path}}"{{with .Key}} data-key="{{.}}"{{end}} {{template "nav" .Path}}{{if .Current}} aria-current="true"{{end}}>{{if .Avatar}}<span class="avatar" data-hue="{{.Hue}}" aria-hidden="true">{{.Initial}}</span> {{end}}{{.Label}}</a>
      {{end}}
    </nav>
  </details>
  <form class="rail-search-wrap" role="search">
    <input id="rail-search" class="rail-search" data-key="mod+k" type="search" name="q" placeholder="Search or jump to…" aria-label="Search sessions" autocomplete="off" hx-get="/rail" hx-sync="#rail-body:replace" hx-trigger="input changed delay:150ms, search" hx-target="#rail-body" hx-swap="outerHTML">
    {{template "icon" "search"}}<kbd aria-hidden="true">⌘K</kbd>
  </form>
  <div class="rail-slot" id="rail"><div id="rail-body" hx-get="/rail" hx-trigger="load" hx-swap="outerHTML"></div></div>
  <div class="sidebar-foot">
    <button type="button" class="sidebar-item shortcuts-button w-full border-0 bg-transparent text-left" data-key="?" data-show-modal="key-sheet">{{template "icon" "keys"}}<span>Shortcuts</span><kbd>?</kbd></button>
  </div>
  {{template "keySheet" .}}
</aside>
{{- end}}
