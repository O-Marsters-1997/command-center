{{define "mark"}}{{if .Name}}<span class="avatar" data-hue="{{.Hue}}" title="{{.Name}}" aria-hidden="true">{{.Initial}}</span>{{end}}{{end}}

{{define "railItem"}}
<a class="rail-link" href="{{.Path}}" {{template "nav" .Path}}{{if .Selected}} aria-current="page"{{end}}>
  <span class="glyph" data-glyph="{{.Glyph}}"></span>
  <span class="rail-ref">{{.Ref}}</span>
  <span class="rail-title">{{.Title}}</span>
  {{- if .Protected}}<span class="flag flag-warning">protected</span>{{end}}
  <span class="rail-state sr-only">{{.Label}}</span>
  {{- if .Started}}<span class="rail-timer" data-started="{{.Started}}"></span>{{end}}
</a>
{{end}}

{{define "railWaitingItem"}}
<a class="rail-link" href="{{.Path}}" {{template "nav" .Path}}{{if .Selected}} aria-current="page"{{end}}>
  <span class="glyph" data-glyph="{{.Glyph}}"></span>
  <span class="rail-ref">{{.Ref}}</span>
  <span class="rail-title">{{.Title}}</span>
  {{- if .Protected}}<span class="flag flag-warning">protected</span>{{end}}
  <span class="rail-state">{{.Label}}</span>
</a>
{{end}}

{{define "railVerb"}}
{{- if .Pending}}
<p class="rail-queued" role="status"><span class="glyph" data-glyph="pending" aria-hidden="true"></span>{{.Verb}} queued</p>
{{- else}}
<form method="post" action="/verb" hx-post="/verb" hx-disabled-elt="find button" hx-include="#rail-search" hx-target="#rail-body" hx-swap="outerHTML">
  <input type="hidden" name="ticket" value="{{.URL}}">
  <input type="hidden" name="from" value="rail">
  <button class="btn btn-sm rail-verb" type="submit" name="verb" value="{{.Verb}}">{{.Verb}}</button>
</form>
{{- end}}
{{- with .Refusal}}
<p class="rail-refusal">{{.}}</p>
{{- end}}
{{end}}

{{define "railReply"}}
<a class="rail-verb" href="{{.Path}}" {{template "nav" .Path}}>Reply</a>
{{end}}

{{define "rail"}}
<div id="rail-body" hx-get="/rail" hx-trigger="every 5s, htmx:pushedIntoHistory from:body, htmx:historyRestore from:body" hx-include="#rail-search" hx-sync="this:drop" hx-swap="outerHTML">
  {{- if .NoMatch}}
  <p class="rail-empty">Nothing matches “{{.Query}}”.</p>
  {{- else}}
  {{- if .NeedsYou}}
  <section class="rail-group" data-group="needs-you" aria-label="Needs you">
    <h2 class="rail-heading">Needs you</h2>
    {{- range .NeedsYou}}
    <div class="rail-card" data-glyph="{{.Glyph}}">
      <a class="rail-link" href="{{.Path}}" {{template "nav" .Path}}{{if .Selected}} aria-current="page"{{end}}>
        <span class="glyph" data-glyph="{{.Glyph}}"></span>
        <span class="rail-title">{{.Title}}</span>
        {{- if .Protected}}<span class="flag flag-warning">protected</span>{{end}}
        {{- with .Updated}}{{if .Age}}<time class="rail-age" datetime="{{.Stamp}}">{{.Age}}</time>{{end}}{{end}}
      </a>
      <p class="rail-context">{{template "mark" .Project}}<span>{{.Feature}}</span><span aria-hidden="true">·</span><span class="rail-ref">{{.Ref}}</span></p>
      <p class="rail-reason{{if .Reply}} rail-question{{end}}"><b>{{.Label}}.</b>{{with .Detail}} {{.}}{{end}}{{with .Last}} {{.}}{{end}}</p>
      {{if .Reply}}{{template "railReply" .}}{{else if .Verb}}{{template "railVerb" .}}{{end}}
    </div>
    {{- end}}
  </section>
  {{- end}}
  <section class="rail-group" data-group="in-flight" aria-label="In flight">
    <h2 class="rail-heading">In flight</h2>
    {{- range .Features}}
    <details class="rail-feature" data-rail-key="{{.Key}}"{{if .Open}} open{{end}}{{if $.Query}} data-rail-forced{{end}}>
      <summary>{{template "icon" "chev"}}{{range .Marks}}{{template "mark" .}}{{end}}<span class="rail-name">{{.Name}}</span> <span class="rail-count"><span class="rail-tally" data-glyph="running">{{len .Working}} working</span><span class="rail-tally rail-tally-waiting">{{.WaitingCount}} waiting</span><span title="merged">{{.Merged}}/{{.Total}}</span></span></summary>
      {{- with .Working}}
      <div class="rail-sub" role="group" aria-label="Working">
        {{- range .}}{{template "railItem" .}}{{end}}
      </div>
      {{- end}}
      {{- if .WaitingCount}}
      <div class="rail-sub rail-sub-waiting" role="group" aria-labelledby="waiting-{{.Key}}">
        <p class="rail-sub-label" id="waiting-{{.Key}}">Waiting</p>
        {{- range .Waiting}}{{template "railWaitingItem" .}}{{end}}
        {{- with .WaitingLine}}<p class="rail-waiting">{{.}}</p>{{end}}
      </div>
      {{- end}}
    </details>
    {{- else}}
    <p class="rail-empty">{{if $.Query}}No match.{{else}}Nothing in flight.{{end}}</p>
    {{- end}}
  </section>
  {{- with .Settled}}{{if or .Items $.Query}}
  <section class="rail-group" data-group="settled" aria-label="Settled">
    <details class="rail-feature" data-rail-key="{{.Key}}"{{if .Open}} open{{end}}{{if $.Query}} data-rail-forced{{end}}>
      <summary>{{template "icon" "chev"}}<span class="rail-name">Settled</span> <span class="rail-count">{{len .Items}}</span></summary>
      {{- range .Items}}
      <div class="rail-settled">
        {{template "railItem" .}}
        {{if .Verb}}{{template "railVerb" .}}{{end}}
      </div>
      {{- else}}
      <p class="rail-empty">No match.</p>
      {{- end}}
    </details>
  </section>
  {{end}}{{end}}
  {{- end}}
</div>
<footer class="rail-footer" id="rail-footer" hx-swap-oob="true">
  {{- range .Gauges}}
  <span class="rail-gauge"><span>{{.Label}}</span><span class="meter"{{if .Stale}} data-stale{{end}}><span class="meter-fill" style="width: {{.Pct}}%"></span></span><span class="rail-pct">{{if .NoReading}}no reading{{else}}{{.Pct}}%{{if .Stale}} · {{.ReadAgo}}{{end}}{{end}}</span></span>
  {{- end}}
  {{- with .Health}}
  {{- if .Error.IsSome}}
  <p class="rail-health banner ribbon" data-glyph="failed" role="status">tick failed {{template "age" .Error.Unwrap.Age}}: {{.Error.Unwrap.Message}}</p>
  {{- else if .Stale}}
  <p class="rail-health banner ribbon" data-glyph="attention" role="status">last good observe: {{template "age" .Observe}}</p>
  {{- end}}
  {{- end}}
</footer>
{{end}}
