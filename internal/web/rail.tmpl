{{define "mark"}}{{if .Name}}<span class="avatar" data-hue="{{.Hue}}" title="{{.Name}}" aria-hidden="true">{{.Initial}}</span>{{end}}{{end}}

{{define "railItem"}}
<a class="rail-link" href="{{.Path}}" {{template "nav" .Path}}{{if .Selected}} aria-current="page"{{end}}>
  <span class="glyph" data-glyph="{{.Glyph}}"></span>
  <span class="rail-ref">{{.Ref}}</span>
  <span class="rail-title">{{.Title}}</span>
  <span class="rail-state sr-only">{{.Glyph}}</span>
  {{- if .Started}}<span class="rail-timer" data-started="{{.Started}}"></span>{{end}}
</a>
{{end}}

{{define "railVerb"}}
<form method="post" action="/verb" hx-post="/verb" hx-disabled-elt="find button" hx-include="#rail-search" hx-target="#rail-body" hx-swap="outerHTML">
  <input type="hidden" name="ticket" value="{{.URL}}">
  <input type="hidden" name="from" value="rail">
  <button class="btn btn-sm rail-verb" type="submit" name="verb" value="{{.Verb}}">{{.Verb}}</button>
</form>
{{end}}

{{define "railReply"}}
<a class="rail-verb" href="{{.Path}}" {{template "nav" .Path}}>Reply</a>
{{end}}

{{define "rail"}}
<div id="rail-body" hx-get="/rail" hx-trigger="every 5s, htmx:pushedIntoHistory from:body, htmx:historyRestore from:body" hx-include="#rail-search" hx-sync="this:drop" hx-swap="outerHTML">
  {{- if .NoMatch}}
  <p class="rail-empty">Nothing matches “{{.Query}}”.</p>
  {{- else}}
  <section class="rail-group" data-group="needs-you" aria-label="Needs you">
    <h2 class="rail-heading">Needs you</h2>
    {{- range .NeedsYou}}
    <div class="rail-card" data-glyph="{{.Glyph}}">
      {{template "railItem" .}}
      <p class="rail-context">{{template "mark" .Project}}<span>{{.Context}}</span></p>
      {{if .Reason}}<p class="rail-reason{{if .Reply}} rail-question{{end}}">{{.Reason}}</p>{{end}}
      {{if .Reply}}{{template "railReply" .}}{{else if .Verb}}{{template "railVerb" .}}{{end}}
    </div>
    {{- else}}
    <p class="rail-empty">{{if $.Query}}No match.{{else}}Nothing needs you.{{end}}</p>
    {{- end}}
  </section>
  <section class="rail-group" data-group="in-flight" aria-label="In flight">
    <h2 class="rail-heading">In flight</h2>
    {{- range .Features}}
    <details class="rail-feature" data-rail-key="{{.Key}}"{{if .Open}} open{{end}}{{if $.Query}} data-rail-forced{{end}}>
      <summary>{{template "icon" "chev"}}{{range .Marks}}{{template "mark" .}}{{end}}<span class="rail-name">{{.Name}}</span> <span class="rail-count">{{len .Live}} live · {{.Waiting}} waiting · {{.Merged}}/{{.Total}} merged</span></summary>
      {{- range .Live}}{{template "railItem" .}}{{end}}
      {{- if .Waiting}}<p class="rail-waiting">{{.WaitingLine}}</p>{{end}}
    </details>
    {{- else}}
    <p class="rail-empty">{{if $.Query}}No match.{{else}}Nothing in flight.{{end}}</p>
    {{- end}}
  </section>
  {{- with .Settled}}{{if or .Items $.Query}}
  <section class="rail-group" data-group="settled" aria-label="Settled">
    <details class="rail-feature" data-rail-key="{{.Key}}"{{if .Open}} open{{end}}{{if $.Query}} data-rail-forced{{end}}>
      <summary>{{template "icon" "chev"}}<span class="rail-name">Settled</span> <span class="rail-count">{{len .Items}}</span></summary>
      {{- range .Items}}
      <div class="rail-settled">
        {{template "railItem" .}}
        {{if .Verb}}{{template "railVerb" .}}{{end}}
      </div>
      {{- else}}
      <p class="rail-empty">No match.</p>
      {{- end}}
    </details>
  </section>
  {{end}}{{end}}
  {{- end}}
  <footer class="rail-footer">
    {{- range .Gauges}}
    <span class="rail-gauge"><span>{{.Label}}</span><span class="meter"><span class="meter-fill" style="width: {{.Pct}}%"></span></span><span class="rail-pct">{{.Pct}}%</span></span>
    {{- end}}
    {{- with .Health}}
    {{- if .Error}}
    <p class="rail-health banner ribbon" data-glyph="failed" role="status">tick failed {{template "age" .Error.Age}}: {{.Error.Message}}</p>
    {{- else}}
    <p class="rail-health">{{.Live}} live · {{if .Stale}}last good observe:{{else}}observed{{end}} {{template "age" .Observe}}</p>
    {{- end}}
    {{- end}}
  </footer>
</div>
{{end}}
