{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<div class="page-narrow">
<div class="repo-head mb-4">
  {{if not .Banner.Polling}}<span class="badge" data-glyph="{{.Banner.Glyph}}"><span class="glyph glyph-{{.Banner.Glyph}}">{{.Banner.State}}</span></span>{{end}}
  <h1>{{.Title}}</h1>
  {{with .Remote}}<p class="page-purpose mb-0">{{.}}</p>{{end}}
</div>
{{template "repoBanner" .Banner}}
{{if .Ready}}
{{template "importRefusal" .LastImportError}}
<section class="module" aria-labelledby="features-h">
<h2 id="features-h">Features</h2>
<table class="w-full">
  <thead><tr><th scope="col">feature</th><th scope="col">imported</th><th scope="col"><span class="sr-only">actions</span></th></tr></thead>
  <tbody>
  {{range .Features}}
  <tr>
    <td>
      <a href="/f/{{.Feature | pathEscape}}">{{.Feature}}</a>
      {{if .OtherRepos}}<span class="text-muted">also in {{range $i, $r := .OtherRepos}}{{if $i}}, {{end}}{{$r}}{{end}}</span>{{end}}
    </td>
    <td>{{if .Imported}}yes{{else}}no{{end}}</td>
    <td>
      <div class="flex justify-end gap-2">
        <form hx-post="/launch/open" hx-target="#launch-modal" hx-swap="innerHTML">
          <input type="hidden" name="feature" value="{{.Feature}}">
          <button type="submit" class="btn btn-sm">Launch</button>
        </form>
        {{if .Imported}}
        <form method="post" action="/features/{{.Feature | pathEscape}}/import">
          <button type="submit" class="btn btn-sm">Reimport</button>
        </form>
        {{end}}
      </div>
    </td>
  </tr>
  {{else}}
  <tr><td colspan="3" class="text-muted">no project: labels found in this repo's tracker.</td></tr>
  {{end}}
  </tbody>
</table>
</section>
<section class="module" aria-labelledby="tickets-h">
<h2 id="tickets-h">Tickets</h2>
{{template "boardForm" .Tickets}}
</section>
{{end}}
</div>
<div id="launch-modal"></div>
{{template "shellEnd" .}}
