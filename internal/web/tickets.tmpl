{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<h1>Tickets</h1>
{{with .Tabs}}{{with index . 0}}<p class="page-purpose">{{.Count}} ticket{{if ne .Count 1}}s{{end}} in this scope.</p>{{end}}{{end}}
<nav class="pill-tabs" aria-label="ticket filters">
  {{- range .Tabs}}
  <a class="pill-tab" href="{{.Path}}" {{template "nav" .Path}}{{if .Current}} aria-current="page"{{end}}>{{.Title}} <span class="section-count">{{.Count}}</span></a>
  {{- end}}
</nav>
{{template "boardForm" .}}
<div id="launch-modal"></div>
{{template "shellEnd" .}}
