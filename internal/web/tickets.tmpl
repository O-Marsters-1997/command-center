{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<h1>All tickets</h1>
<p class="page-purpose">{{.OpenCount}} open across {{.FeatureCount}} {{if eq .FeatureCount 1}}feature{{else}}features{{end}}{{if .ProjectCount}} in {{.ProjectCount}} {{if eq .ProjectCount 1}}project{{else}}projects{{end}}{{end}}.</p>
<nav class="pill-tabs" aria-label="ticket filters">
  {{- range .Tabs}}
  <a class="pill-tab" href="{{.Path}}" {{template "nav" .Path}}{{if .Current}} aria-current="page"{{end}}>{{.Title}} <span class="section-count">{{.Count}}</span></a>
  {{- end}}
</nav>
{{template "board" .}}
{{template "shellEnd" .}}
