{{/* PROTOTYPE (branch prototype/session-disclosure): the Thread session page. ?variant=current shows the old page. Never merge. */}}
{{define "protoMain"}}{{template "protoStyle"}}{{template "protoA" .}}{{end}}

{{define "protoTitle"}}<header class="pv-head">
  <h1 class="pv-title">{{or .Row.Title .Ref}}</h1>
  <p class="pv-meta">
    <span class="glyph glyph-{{.Row.Glyph}}{{if .Row.Alive}} glyph-pulse{{end}}" data-glyph="{{.Row.Glyph}}">{{.Row.Label}}</span>
    <span class="pv-sep" aria-hidden="true"></span><span>{{.Row.Repo}} {{.Ref}}</span>
    {{- with .Row.Branch}}<span class="pv-sep" aria-hidden="true"></span><span class="pv-mono" title="{{$.Row.Worktree}}">{{.}}</span>{{end}}
    {{- with .PRURL}}<span class="pv-sep" aria-hidden="true"></span><a href="{{.}}" target="_blank" rel="noopener">PR #{{$.Row.PRNumber}}</a>{{end}}
    {{- with .Worked}}{{if .IsSome}}{{with .Unwrap}}<span class="pv-sep" aria-hidden="true"></span><span class="pv-num">{{.Wall}}{{if .Turns}} · {{.Turns}} turns{{end}}</span>{{end}}{{end}}{{end}}
  </p>
  {{- if .Callout}}{{with .Row.Detail}}<p class="pv-reason">{{.}}</p>{{end}}{{end}}
  {{- with .Row.ProtectedLinks}}
  <details class="session-protected pv-protected">
    <summary><span class="flag flag-warning">protected</span> {{len .}} protected {{if eq (len .) 1}}change{{else}}changes{{end}}</summary>
    <ul class="font-mono text-xs">
      {{- range .}}
      <li>{{if .Href}}<a href="{{.Href}}" target="_blank" rel="noopener">{{.Path}}</a>{{else}}{{.Path}}{{end}} <span class="text-muted">{{.Rule}}</span> +{{.Added}} −{{.Deleted}}</li>
      {{- end}}
    </ul>
  </details>
  {{- end}}
</header>{{end}}

{{define "protoPrompt"}}<details class="pv-prompt">
  <summary>{{template "icon" "doc"}}<span class="pv-prompt-label">Prompt</span>
    <span class="pv-clip">{{if .Prompt.Kept}}{{.Prompt.Text}}{{else}}not kept{{end}}</span>
    <span class="pv-num pv-faint">{{with .Launched}}{{if .IsSome}}{{template "age" .Unwrap}}{{end}}{{end}}</span></summary>
  {{- if .Prompt.Kept}}<pre class="pv-prompt-body">{{.Prompt.Text}}</pre>{{end}}
</details>{{end}}

{{define "protoBar"}}<div class="pv-bar">
  {{template "stepStrip" .}}
  <nav class="pv-tabs" aria-label="log view">
    <a href="{{.TranscriptPath}}"{{if not .Raw}} aria-current="page"{{end}}>Transcript</a>
    <a href="{{.RawPath}}"{{if .Raw}} aria-current="page"{{end}}>Raw log</a>
    <a href="{{.ChangesPath}}">Changes</a>
  </nav>
</div>{{end}}

{{define "protoSkill"}}<span class="pv-skill">{{template "icon" "zap"}}{{.}}</span>{{end}}

{{define "protoCall"}}{{if or (eq .Kind "skill") (eq .Verb "Skill")}}<div class="pv-call-skill">{{template "protoSkill" .Arg}}</div>
{{- else}}<details class="pv-call"{{if .Failed}} data-glyph="failed"{{end}}{{if .CallID}} id="call-{{.CallID}}"{{end}}>
  <summary><span class="pv-call-verb">{{.Verb}}</span><code class="pv-call-arg">{{.Arg}}</code><span class="pv-call-res">{{if and (not .Failed) (or .Added .Removed)}}<span class="diff-plus">+{{.Added}}</span> <span class="diff-minus">−{{.Removed}}</span>{{else}}{{.Result}}{{end}}</span></summary>
  <div class="pv-call-body">
    {{- with .Arg}}<pre class="pv-out pv-out-arg">{{.}}</pre>{{end}}
    {{- with .Output}}<pre class="pv-out">{{.}}</pre>{{end}}
    {{- with .Diff}}<div class="call-diff">{{range .}}<div class="diff-row diff-{{.Op}}">{{.Text}}</div>{{end}}</div>{{end}}
    {{- if not (or .Output .Diff)}}<p class="pv-faint pv-small">No output kept.</p>{{end}}
  </div>
</details>{{end}}{{end}}

{{define "protoTools"}}<details class="pv-tools">
  <summary>
    <span class="pv-chev" aria-hidden="true">{{template "icon" "chev"}}</span>
    <span class="pv-count">{{len .Lines}} tool {{if eq (len .Lines) 1}}call{{else}}calls{{end}}</span>
    {{- with .FailNote}}<span class="pv-fail">{{.}}</span>{{end}}
    {{- range .Lines}}{{if or (eq .Kind "skill") (eq .Verb "Skill")}}{{template "protoSkill" .Arg}}{{end}}{{end}}
    <span class="pv-mix">{{.Summary}}</span>
  </summary>
  <div class="pv-tools-body">{{range .Lines}}{{template "protoCall" .}}{{end}}</div>
</details>{{end}}

{{define "protoEvent"}}<div class="pv-event"><span class="pv-event-verb">{{.Verb}}</span>{{with .Arg}}<span class="pv-event-arg">{{if $.Href}}<a href="{{$.Href}}" target="_blank" rel="noopener">{{.}}</a>{{else}}{{.}}{{end}}</span>{{end}}{{with .Result}}<span class="pv-num pv-event-at">{{.}}</span>{{end}}</div>{{end}}

{{define "protoA"}}<div class="pv">
  {{template "protoTitle" .}}
  {{template "protoPrompt" .}}
  {{template "protoBar" .}}
  {{- if .Raw}}{{if .RawText}}<pre class="raw-log">{{.RawText}}</pre>{{end}}{{else}}
  <div class="pv-thread">
    {{- range .Turns}}
    {{- with .You}}<div class="pv-you">{{.}}</div>{{end}}
    {{- range .Log.Phases}}
      {{- with .Skill}}<div class="pv-call-skill">{{template "protoSkill" .}}</div>{{end}}
      {{- range .Items}}
        {{- if .Folded}}{{template "protoTools" .Group}}
        {{- else if .FirstFail}}
        {{- else if eq .Line.Shape "say"}}<div class="pv-say">{{template "logline" .Line}}</div>
        {{- else if eq .Line.Shape "record"}}{{if .Line.Checks}}<div class="pv-checks">{{template "logline" .Line}}</div>{{else}}{{template "protoEvent" .Line}}{{end}}
        {{- else}}{{template "protoCall" .Line}}{{end}}
      {{- end}}
    {{- end}}
    {{- with .Log.StreamPath}}<div class="run-log-live" hx-ext="sse" sse-connect="{{.}}" sse-swap="message" sse-close="end" hx-swap="beforeend"></div>{{end}}
    {{- with .Log.Final}}<section class="pv-final" data-glyph="{{$.Row.Glyph}}" aria-label="Result">
      <p class="pv-final-label"><span class="glyph glyph-{{$.Row.Glyph}}" aria-hidden="true"></span>Result</p>
      {{template "logline" .}}
    </section>{{end}}
    {{- with .Ask}}<section class="pv-final pv-ask" data-glyph="attention" aria-label="The agent asks">
      <p class="pv-final-label"><span class="glyph glyph-attention" aria-hidden="true"></span>The agent asks</p>
      <p class="pv-ask-text">{{.}}</p>
    </section>{{end}}
    {{- end}}
  </div>
  {{- end}}
  {{template "sessionActions" .}}
  {{template "sessionComposer" .}}
</div>{{end}}

{{define "protoSwitch"}}{{if true}}<div class="pv-switch" role="toolbar" aria-label="Prototype variant">
  <a href="?variant={{if eq .Variant "current"}}a{{else}}current{{end}}">{{if eq .Variant "current"}}Current page · show Thread →{{else}}Thread · show current →{{end}}</a>
</div>
<style>
.pv-switch { position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 1000; padding: 8px 14px; border-radius: 9999px; background: var(--color-ink); box-shadow: var(--shadow-overlay); font: 500 12px/1 var(--font-mono); }
.pv-switch a { color: var(--color-canvas); text-decoration: none; }
</style>{{end}}{{end}}

{{define "protoStyle"}}<style>
/* Voice: the agent's prose. Machinery: everything that can be expanded. */
.pv { --pv-voice: var(--color-fg); --pv-machine: var(--color-muted); --pv-faint: var(--color-meta);
  display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
.pv .icon { width: 12px; height: 12px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.pv :where(summary, a):focus-visible { outline: none; border-radius: var(--radius-xs); box-shadow: var(--shadow-focus); }
.pv details > summary { list-style: none; cursor: pointer; }
.pv details > summary::-webkit-details-marker { display: none; }
.pv-faint { color: var(--pv-faint); }
.pv-small { margin: 0; font-size: var(--text-2xs); }
.pv-mono, .pv-num { font-family: var(--font-mono); font-size: 0.92em; font-variant-numeric: tabular-nums; }

.pv-head { display: flex; flex-direction: column; gap: 6px; }
.pv-title { margin: 0; font-size: var(--text-xl); font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-display); line-height: 1.25; text-wrap: balance; }
.pv-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px var(--space-2); margin: 0; font-size: var(--text-xs); color: var(--pv-machine); }
.pv-meta a { color: inherit; text-underline-offset: 3px; }
.pv-sep { width: 3px; height: 3px; border-radius: 50%; background: var(--color-border-strong); }
.pv-reason { margin: 2px 0 0; color: var(--color-fg-2); font-size: var(--text-sm); }

.pv-chev { display: inline-flex; color: var(--pv-faint); transition: transform var(--motion-base) var(--ease-out); }
details[open] > summary > .pv-chev { transform: rotate(90deg); }

/* Prompt: a white bar that opens in place. */
.pv-prompt { border: 1px solid var(--color-border-soft); border-radius: var(--radius-lg); background: var(--color-surface); }
.pv-prompt > summary { display: flex; align-items: center; gap: var(--space-2); min-height: var(--hit-min); padding: var(--space-2) var(--space-3); font-size: var(--text-xs); color: var(--pv-faint); border-radius: inherit; }
.pv-prompt-label { flex: none; color: var(--pv-machine); font-weight: var(--font-weight-medium); }
.pv-clip { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pv-prompt > summary:hover, .pv-prompt > summary:hover .pv-prompt-label { color: var(--color-fg-2); }
.pv-prompt[open] .pv-clip { visibility: hidden; }
.pv-prompt-body { margin: 0; padding: var(--space-3) var(--space-4) var(--space-4); border-top: 1px solid var(--color-border-soft); font: var(--text-sm)/var(--leading-read) var(--font-sans); color: var(--color-fg-2); white-space: pre-wrap; max-height: 50vh; overflow: auto; }

.pv-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border-soft); }
.pv-bar #step-strip { margin: 0; }
.pv-tabs { display: flex; gap: var(--space-4); font-size: var(--text-sm); }
.pv-tabs a { padding: 2px 0; border-bottom: 1.5px solid transparent; color: var(--pv-machine); text-decoration: none; }
.pv-tabs a:hover { color: var(--color-fg); }
.pv-tabs a[aria-current="page"] { color: var(--color-fg); border-bottom-color: var(--color-fg); }

/* The thread. Machinery rows sit tight; voice gets air above and below. */
.pv-thread { display: flex; flex-direction: column; gap: 2px; }

.pv-say { margin: var(--space-4) 0; max-width: 66ch; font-size: var(--text-md); line-height: 1.68; letter-spacing: -0.011em; color: var(--pv-voice); }
.pv-thread > .pv-say:first-child { margin-top: var(--space-2); }
.pv-say .prose p { max-width: none; margin: 0 0 0.7em; text-wrap: pretty; }
.pv-say .prose p:last-child, .pv-say .prose ul:last-child { margin-bottom: 0; }
.pv-say .prose ul { margin: 0 0 0.7em; padding-left: 1.2em; }
.pv-say .prose li { margin: 0.3em 0; padding-left: 0.15em; }
.pv-say .prose li::marker { color: var(--pv-faint); }
.pv-say strong { font-weight: var(--font-weight-semibold); color: var(--color-ink); }
.pv-say .code-chip, .pv-final .code-chip { padding: 0.06em 0.36em; border: 0; border-radius: var(--radius-xs); background: var(--color-surface-3); color: var(--color-fg); font-size: 0.84em; }

.pv-you { align-self: flex-end; max-width: 80%; margin: var(--space-4) 0; padding: var(--space-2) var(--space-3); border-radius: var(--radius-lg) var(--radius-lg) var(--radius-xs) var(--radius-lg); background: var(--color-accent-soft); white-space: pre-wrap; font-size: var(--text-read); }

.pv-tools > summary { display: flex; align-items: center; gap: var(--space-2); min-height: 26px; font-size: var(--text-xs); color: var(--pv-machine); min-width: 0; }
.pv-tools > summary > * { flex: none; }
.pv-count { font-variant-numeric: tabular-nums; }
.pv-fail { color: var(--color-s-failed); font-variant-numeric: tabular-nums; }
.pv-fail::before { content: "·"; margin-right: var(--space-2); color: var(--pv-faint); }
.pv-tools > summary > .pv-mix { flex: 1 1 0; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--pv-faint); opacity: 0; transition: opacity var(--motion-fast) var(--ease-out); }
.pv-tools > summary:hover > .pv-mix, .pv-tools > summary:focus-visible > .pv-mix, .pv-tools[open] > summary > .pv-mix { opacity: 1; }
.pv-tools > summary:hover, .pv-tools[open] > summary { color: var(--color-fg-2); }
.pv-tools-body { display: flex; flex-direction: column; margin: 2px 0 var(--space-3) 5px; padding-left: 14px; border-left: 1px solid var(--color-border-soft); }

/* Skills: a filled bolt and medium weight, in ink, not indigo. */
.pv-skill { display: inline-flex; align-items: center; gap: 3px; color: var(--color-fg-2); font-size: var(--text-xs); font-weight: var(--font-weight-medium); }
.pv-skill .icon { width: 11px; height: 11px; fill: currentColor; stroke: none; }
.pv-tools > summary .pv-skill { padding: 0 6px 0 4px; border: 1px solid var(--color-border); border-radius: 9999px; line-height: 18px; }
.pv-call-skill { display: flex; min-height: 24px; align-items: center; }

.pv-call > summary { display: flex; align-items: baseline; gap: var(--space-2); padding: 3px 0; font-size: var(--text-xs); min-width: 0; }
.pv-call-verb { flex: none; color: var(--pv-machine); font-weight: var(--font-weight-medium); }
.pv-call-arg { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-family: var(--font-mono); font-size: 11.5px; color: var(--pv-faint); }
.pv-call-res { flex: none; font-family: var(--font-mono); font-size: 11.5px; color: var(--pv-faint); }
.pv-call > summary:hover .pv-call-arg, .pv-call[open] .pv-call-arg { color: var(--color-fg-2); }
.pv-call[data-glyph] .pv-call-verb, .pv-call[data-glyph] .pv-call-res { color: var(--color-s-failed); }
.pv-call-body { margin: 2px 0 var(--space-2); }
.pv-out { margin: 0 0 var(--space-1); padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); background: var(--color-surface-2); font-family: var(--font-mono); font-size: 11.5px; line-height: 1.55; color: var(--color-fg-2); white-space: pre-wrap; overflow-wrap: anywhere; max-height: 22rem; overflow: auto; }
.pv-out-arg { background: transparent; box-shadow: inset 0 0 0 1px var(--color-border-soft); }
.pv-call[data-glyph] .pv-out:not(.pv-out-arg) { color: var(--color-s-failed); background: var(--color-s-failed-soft); }

.pv-event { display: flex; align-items: baseline; gap: var(--space-2); min-height: 22px; font-size: var(--text-2xs); color: var(--pv-faint); }
.pv-event-verb { color: var(--pv-machine); }
.pv-event-arg { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pv-event-arg a { color: inherit; text-underline-offset: 2px; }
.pv-event-at { margin-left: auto; }
.pv-checks { font-size: var(--text-xs); }

/* The handover: the result opens under a hairline, full column width. */
.pv-final { margin: var(--space-5) 0 var(--space-2); padding-top: var(--space-4); border-top: 1px solid var(--color-border-soft); font-size: var(--text-md); line-height: 1.68; letter-spacing: -0.011em; color: var(--pv-voice); animation: pv-arrive 420ms var(--ease-out) both; }
.pv-final .prose p { max-width: none; margin: 0 0 0.7em; text-wrap: pretty; }
.pv-final .prose > :last-child { margin-bottom: 0; }
.pv-final strong { font-weight: var(--font-weight-semibold); color: var(--color-ink); }
.pv-final-label { display: flex; align-items: center; gap: 6px; margin: 0 0 var(--space-2); font-size: var(--text-xs); font-weight: var(--font-weight-medium); letter-spacing: 0; color: var(--pv-machine); }
.pv-ask-text { margin: 0; font-weight: var(--font-weight-medium); }
@keyframes pv-arrive { from { opacity: 0; transform: translateY(6px); } }
@media (prefers-reduced-motion: reduce) { .pv-final { animation: none; } .pv-chev, .pv-mix { transition: none; } }


@media (max-width: 759px) {
  .pv-bar { flex-direction: column; align-items: flex-start; }
  .pv-tools > summary { flex-wrap: wrap; row-gap: 4px; padding: 3px 0; }
  .pv-tools > summary > .pv-mix { display: none; }
  .pv-say, .pv-final { font-size: var(--text-read); }
}
</style>{{end}}
