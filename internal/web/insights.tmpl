{{define "insightsKeep"}}{{with .Project}}<input type="hidden" name="project" value="{{.}}">{{end}}
<input type="hidden" name="range" value="{{.Range}}"><input type="hidden" name="metric" value="{{.Metric}}"><input type="hidden" name="rework" value="{{.Rework}}"><input type="hidden" name="view" value="{{.View}}">{{end}}

{{define "insightsSpark"}}<svg class="pulse-spark" width="72" height="28" viewBox="0 0 72 28" aria-hidden="true">
  <defs><linearGradient id="spark-{{.Metric}}" x1="0" y1="0" x2="0" y2="1"><stop class="pulse-spark-top" offset="0"></stop><stop class="pulse-spark-bottom" offset="1"></stop></linearGradient></defs>
  <path d="{{.Spark}} V28 H0 Z" fill="url(#spark-{{.Metric}})"></path>
  <path class="pulse-spark-line" d="{{.Spark}}"></path>
</svg>{{end}}

{{template "shellStart" .}}
{{template "scopeCrumbs" .}}
{{template "shellAction" .}}
{{template "shellContent" .}}
<header class="pulse-head">
  <div>
    <h1>Insights</h1>
    <p class="page-purpose mb-0">{{.Scope}}</p>
  </div>
  <div class="ml-auto flex flex-wrap items-center gap-2">
    <form action="/insights" method="get" {{template "nav" "/insights"}} hx-trigger="change">
      {{template "insightsKeep" .Params}}{{with .Params.Feature}}<input type="hidden" name="feature" value="{{.}}">{{end}}
      <select class="select" name="repo" aria-label="Repository">
        <option value="">All repos ({{len .Repos}})</option>
        {{range .Repos}}<option value="{{.Label}}"{{if .Current}} selected{{end}}>{{.Label}}</option>
        {{end -}}
      </select>
    </form>
    <nav class="pill-tabs" aria-label="Range">
      {{range .Ranges}}<a class="pill-tab" href="{{.Path}}" {{template "nav" .Path}}{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>
      {{end -}}
    </nav>
  </div>
</header>
<div class="pulse-grid">
  <section class="pulse-card" aria-labelledby="cost-h">
    <h2 id="cost-h">Per merged ticket</h2>
    <p class="module-sub mb-0">Median per ticket, from launch to merge.</p>
    <nav class="pulse-tiles" aria-label="Metric">
      {{range $t := .Tiles}}<a class="pulse-tile" href="{{$t.Path}}" {{template "nav" $t.Path}}{{if eq $t.Metric $.Cost.Selected}} aria-current="page"{{end}}>
        <span class="pulse-tile-label">{{$t.Label}}</span>
        <span class="flex items-end justify-between gap-2">
          <b class="pulse-tile-figure">{{$t.Figure}}</b>
          {{if $t.Spark}}{{template "insightsSpark" $t}}{{end}}
        </span>
        {{with $t.Chip}}<span><span class="pulse-chip"{{if $t.Change.IsSome}} data-tone="{{$t.Change.Unwrap.Tone}}"{{end}}>{{.}}</span></span>{{end}}
      </a>
      {{end -}}
    </nav>
    {{range $t := .Tiles}}{{if eq $t.Metric $.Cost.Selected}}<p class="mt-5 mb-0 flex flex-wrap items-baseline gap-2">
      <b class="text-3xl font-semibold tabular-nums">{{$t.Figure}}</b>
      <span class="text-muted">median {{$t.Label}} per ticket{{with $t.Chip}}, <span class="pulse-chip"{{if $t.Change.IsSome}} data-tone="{{$t.Change.Unwrap.Tone}}"{{end}}>{{.}}</span> vs the prior {{$.Params.Days}} days{{end}}</span>
    </p>{{end}}{{end}}
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
      <form action="/insights" method="get" {{template "nav" "/insights"}} hx-trigger="change">
        {{template "insightsKeep" .Params}}{{with .Params.Repo}}<input type="hidden" name="repo" value="{{.}}">{{end}}
        <select class="select" name="feature" aria-label="Feature">
          <option value="">All features</option>
          {{range .Features}}<option value="{{.Label}}"{{if .Current}} selected{{end}}>{{.Label}}</option>
          {{end -}}
        </select>
      </form>
      <nav class="pill-tabs" aria-label="Grouping">
        <a class="pill-tab" href="{{.Params.ViewPath "ticket"}}" {{template "nav" (.Params.ViewPath "ticket")}}{{if eq .Params.View "ticket"}} aria-current="page"{{end}}>Each ticket</a>
        <a class="pill-tab" href="{{.Params.ViewPath "week"}}" {{template "nav" (.Params.ViewPath "week")}}{{if eq .Params.View "week"}} aria-current="page"{{end}}>By week</a>
      </nav>
    </div>
    <div class="mt-4">
      {{if .Cost.Dots}}<cc-insights-chart src="{{.ChartSrc}}">Loading chart…</cc-insights-chart>
      <script type="module" src="/assets/dist/insights-chart.js"></script>
      {{else}}<p class="text-muted">No merged tickets in the last {{.Params.Days}} days</p>{{end}}
    </div>
  </section>
  <section class="pulse-card" aria-labelledby="limits-h">
    <h2 id="limits-h">Limits</h2>
    <ul class="pulse-limits" aria-label="limits">
      {{range .Limits}}<li class="pulse-limit">
        <span class="flex items-baseline justify-between gap-2"><span>{{.Label}}</span><b class="tabular-nums">{{if .NoReading}}—{{else}}{{.Pct}}%{{end}}</b></span>
        <span class="meter" role="meter"{{if .Stale}} data-stale{{end}}{{if not .NoReading}} aria-valuenow="{{.Pct}}"{{end}} aria-valuemin="0" aria-valuemax="100" aria-label="{{.Label}}"><span class="meter-fill" style="width: {{.Pct}}%"></span></span>
        <span class="text-muted text-xs">{{if .NoReading}}No reading · reset unknown{{else if .ResetsIn}}resets <time datetime="{{.ResetsAt.UTC.Format "2006-01-02T15:04:05Z07:00"}}">{{.ResetsIn}}</time>{{if .Stale}} · {{.ReadAgo}}{{end}}{{else}}no reset time yet{{end}}</span>
      </li>
      {{end -}}
    </ul>
    <p class="module-sub mt-4 mb-0">Readings come from the usage lines agents write while they run, so a window with no recent run has no reading.</p>
  </section>
</div>
<section class="pulse-card mt-4" aria-labelledby="rework-h">
  <h2 id="rework-h">Rework</h2>
  <p class="module-sub mb-0">How many pushes merged tickets needed before CI went green, and what the extra pushes cost.</p>
  <nav class="pulse-tiles" data-cols="3" aria-label="Rework metric">
    {{range $t := .ReworkView}}<a class="pulse-tile" href="{{$t.Path}}" {{template "nav" $t.Path}}{{if eq (printf "%s" $t.Metric) (printf "%s" $.Rework.Selected)}} aria-current="page"{{end}}>
      <span class="pulse-tile-label">{{$t.Label}}</span>
      <span class="flex items-end justify-between gap-2">
        <b class="pulse-tile-figure">{{$t.Figure}}</b>
        {{if $t.Spark}}{{template "insightsSpark" $t}}{{end}}
      </span>
      {{with $t.Chip}}<span><span class="pulse-chip"{{if $t.Change.IsSome}} data-tone="{{$t.Change.Unwrap.Tone}}"{{end}}>{{.}}</span></span>{{end}}
    </a>
    {{end -}}
  </nav>
  {{if .Rework.Weeks}}<div class="mt-4">
    <cc-insights-chart mode="rework" src="{{.ReworkSrc}}">Loading chart…</cc-insights-chart>
    <script type="module" src="/assets/dist/insights-chart.js"></script>
  </div>
  <div class="band-cols mt-4">
    {{range .Bands}}<div class="band-col" data-band="{{.Glyph}}">
      <span class="band-label">{{.Label}}</span>
      <b class="band-figure">{{.Count}} <span class="text-muted font-normal">{{.Share}}</span></b>
      <span class="text-muted text-sm">median {{.Tokens}} tokens · {{.Wall}}</span>
    </div>
    {{end -}}
  </div>
  {{else}}<p class="text-muted mt-4 mb-0">No merged tickets in the last {{.Params.Days}} days</p>{{end}}
</section>
<div class="pulse-grid pulse-grid-even mt-4">
  <section class="pulse-card" aria-labelledby="parks-h">
    <h2 id="parks-h">Why runs parked</h2>
    <p class="module-sub mb-0">Reasons agents handed a ticket back to you, with the tokens those runs spent.</p>
    {{if .Parks}}<div class="table-frame mt-3">
      <table class="ledger w-full" aria-label="why runs parked">
        <thead><tr><th scope="col">Reason</th><th scope="col" class="text-right">Times</th><th scope="col" class="text-right">Tokens</th></tr></thead>
        <tbody>
          {{range .Parks}}<tr>
            <th scope="row" class="w-full max-w-0"><span class="block truncate" title="{{.Example}}">{{.Reason}}</span></th>
            <td class="text-right tabular-nums"><span class="inline-flex items-center justify-end gap-2"><span class="ledger-bar hidden sm:block" aria-hidden="true"><span style="width: {{$.ParkShare .Times}}%"></span></span>{{.Times}}</span></td>
            <td class="text-right tabular-nums">{{$.Tokens .Tokens}}</td>
          </tr>
          {{end -}}
        </tbody>
      </table>
    </div>
    {{else}}<p class="text-muted mt-3 mb-0">No parked runs in the last {{.Params.Days}} days</p>{{end}}
  </section>
  <section class="pulse-card" aria-labelledby="jobs-h">
    <h2 id="jobs-h">Failing jobs</h2>
    <p class="module-sub mb-0">CI checks that failed on a pushed ticket, with the tokens fix runs spent on them.</p>
    {{if .Jobs}}<div class="table-frame mt-3">
      <table class="ledger w-full" aria-label="failing jobs">
        <thead><tr><th scope="col">Job</th><th scope="col" class="text-right">Failures</th><th scope="col" class="text-right">Fix tokens</th></tr></thead>
        <tbody>
          {{range .Jobs}}<tr>
            <th scope="row" class="w-full max-w-0"><span class="flex min-w-0 items-center gap-2"><span class="truncate font-mono" title="{{.Name}}">{{.Name}}</span><span class="chip shrink-0">{{.Repo}}</span></span></th>
            <td class="text-right tabular-nums"><span class="inline-flex items-center justify-end gap-2"><span class="ledger-bar hidden sm:block" aria-hidden="true"><span style="width: {{$.JobShare .Failures}}%"></span></span>{{.Failures}}</span></td>
            <td class="text-right tabular-nums">{{$.Tokens .FixTokens}}</td>
          </tr>
          {{end -}}
        </tbody>
      </table>
    </div>
    {{else}}<p class="text-muted mt-3 mb-0">No failing jobs in the last {{.Params.Days}} days</p>{{end}}
    <p class="module-sub mt-3 mb-0">Rollup checks, such as the repo's insights.rollup_checks (default *-status-check), are left out: they fail whenever any job does.</p>
  </section>
</div>
<div class="pulse-grid mt-4">
  <section class="pulse-card" aria-labelledby="hotspots-h">
    <h2 id="hotspots-h">Conflict hotspots</h2>
    <p class="module-sub mb-0">Paths merge conflicts left unresolved. A repeat is a ticket conflicting again on a path it already conflicted on.</p>
    {{if .Hotspots}}<div class="table-frame mt-3">
      <table class="w-full" aria-label="conflict hotspots">
        <thead><tr><th scope="col">Path</th><th scope="col" class="text-right">Tickets</th><th scope="col" class="text-right">Repeats</th></tr></thead>
        <tbody>
          {{range .Hotspots}}<tr>
            <th scope="row" class="w-full max-w-0"><span class="flex min-w-0 items-center gap-2"><span class="truncate font-mono" title="{{.Path}}">{{.Path}}</span>{{if .Generated}}<span class="chip shrink-0">generated</span>{{end}}</span></th>
            <td class="text-right tabular-nums"><span class="inline-flex items-center justify-end gap-2"><span class="meter hidden w-16 sm:block" aria-hidden="true"><span class="meter-fill" style="width: {{$.HotspotShare .Tickets}}%"></span></span>{{.Tickets}}</span></td>
            <td class="text-right tabular-nums{{if not .Repeats}} text-muted{{end}}">{{if .Repeats}}{{.Repeats}}{{else}}—{{end}}</td>
          </tr>
          {{end -}}
        </tbody>
      </table>
    </div>
    {{else}}<p class="text-muted mt-3 mb-0">No conflicts recorded in the last {{.Params.Days}} days</p>{{end}}
  </section>
  <section class="pulse-card" aria-labelledby="stack-h">
    <h2 id="stack-h">Should have been stacked</h2>
    <p class="module-sub mb-0">Tickets in one feature, open at once, that conflicted on the same hand-written path.</p>
    {{if .Pairs}}<ul class="insight-pairs mt-3">
      {{range .Pairs}}<li class="insight-pair">
        <span><span class="font-mono" title="{{.A}}">{{$.TicketName .A}}</span> <span class="text-muted">and</span> <span class="font-mono" title="{{.B}}">{{$.TicketName .B}}</span></span>
        <span class="min-w-0 truncate font-mono text-muted" title="{{.Path}}">{{.Path}}</span>
      </li>
      {{end -}}
    </ul>
    {{else}}<p class="text-muted mt-3 mb-0">No pairs in the last {{.Params.Days}} days</p>{{end}}
  </section>
</div>
{{template "shellEnd" .}}
