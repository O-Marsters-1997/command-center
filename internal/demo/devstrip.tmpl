{{define "strip"}}
<style>
#dev-strip {
  position: fixed; inset: auto 0 0 0; z-index: 50;
  display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem;
  padding: 0.5rem 1rem; font: 0.75rem var(--font-mono);
  color: var(--color-fg); background: var(--color-bg); border-top: 1px solid var(--color-border);
}
#dev-strip form { display: flex; align-items: center; gap: 0.25rem; margin: 0; }
#dev-strip input { width: 5rem; }
</style>
<aside id="dev-strip" aria-label="demo controls" hx-target="#dev-strip-state" hx-swap="outerHTML">
  <strong>demo</strong>
  <form hx-post="/dev/pause"><button type="submit">pause</button></form>
  <form hx-post="/dev/resume"><button type="submit">resume</button></form>
  <form hx-post="/dev/speed">
    <label>speed <input type="number" name="speed" min="0.1" step="any" value="{{.Speed}}">x</label>
    <button type="submit">set</button>
  </form>
  <form hx-post="/dev/jump">
    <label>jump to <input type="text" name="to" placeholder="45m"></label>
    <button type="submit">go</button>
  </form>
  <form hx-post="/dev/restart"><button type="submit">restart</button></form>
  {{template "state" .}}
</aside>
{{end}}

{{define "state"}}
<div id="dev-strip-state" hx-get="/dev/state" hx-trigger="every 1s" hx-swap="outerHTML" hx-target="this">
  <span>{{if .Paused}}paused{{else}}playing at {{.Speed}}x{{end}}, sim time {{.Elapsed}}</span>
  {{if .Error}}<span role="alert">{{.Error}}</span>{{end}}
  {{range .PRs}}
  <form hx-post="/dev/merge-now" hx-target="#dev-strip-state" hx-swap="outerHTML">
    <input type="hidden" name="number" value="{{.Number}}">
    <button type="submit">merge #{{.Number}} now ({{.Ticket}})</button>
  </form>
  {{end}}
</div>
{{end}}
