{{define "logline"}}<div class="line line-{{.Kind}}"{{if .Anchor}} id="first-fail"{{end}}>{{if eq .Kind "skill"}}<span class="line-label">skill</span> {{.Tool}}{{with .Detail}} · {{.}}{{end}}{{else if eq .Kind "file"}}<span class="line-label">+</span> {{.Detail}}{{else if eq .Kind "tool"}}<span class="line-label">tool</span> {{.Tool}}{{with .Detail}} {{.}}{{end}}{{else if eq .Kind "fail"}}<span class="line-label">fail</span>{{with .Detail}} {{.}}{{end}}{{else if eq .Kind "pass"}}<span class="line-label">pass</span>{{with .Detail}} {{.}}{{end}}{{end}}</div>{{end}}
