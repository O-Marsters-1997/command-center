<td colspan="10">
  <dl class="m-0 grid grid-cols-[max-content_1fr] gap-x-4">
    <dt class="text-muted">base sha</dt><dd class="m-0">{{.BaselineSHA}}</dd>
    <dt class="text-muted">worktree</dt><dd class="m-0">{{if .Worktree}}{{.Worktree}}{{else}}no worktree has been cut{{end}}</dd>
    <dt class="text-muted">elapsed</dt><dd class="m-0">{{if .Elapsed}}{{.Elapsed}}{{else}}not started{{end}}</dd>
    <dt class="text-muted">checks</dt>
    <dd class="m-0">
      {{- range .Checks}}<div>{{.Name}}: {{.Status}}{{with .Conclusion}} {{.}}{{end}}</div>{{else}}no checks{{end -}}
    </dd>
    {{if .Draft}}<dt class="text-muted">draft</dt><dd class="m-0">{{.DraftReason}}</dd>{{end}}
    {{if .BaseVerdict}}<dt class="text-muted">base verdict</dt><dd class="m-0">{{.BaseVerdict}}</dd>{{end}}
    {{if .Warning}}<dt class="text-muted">warning</dt><dd class="m-0">{{.Warning}}</dd>{{end}}
  </dl>
  <div class="run-log">
    <div class="run-log-header flex flex-wrap items-center gap-2">
      <span class="run-log-path font-medium">{{.Log.Path}}</span>
      {{if .Log.Streaming}}<span class="pill" data-tone="live"><span class="pill-pulse"></span>streaming</span>
      {{- else}}<span class="pill"><span class="pill-ring"></span>ended</span>{{end}}
      <nav class="log-filters flex gap-2">
        {{- range .Log.Filters}}<a href="{{.Path}}" class="px-1{{if .Active}} active font-semibold{{end}}"{{if .Active}} aria-current="true"{{end}}>{{.Label}}</a>{{end -}}
      </nav>
      <a href="#first-fail" class="jump-first-fail ml-auto">first failure</a>
    </div>
    <p class="run-log-meta text-muted">{{.Log.Lines}} lines · {{.Log.PhaseCount}} phases</p>
    {{range .Log.Phases}}
    <section class="phase">
      <header class="flex items-baseline gap-2 mt-5 mb-1 pb-1 border-b border-border text-muted text-xs tracking-wide uppercase">
        {{if .Skill}}<span class="phase-skill font-semibold">skill {{.Skill}}</span>{{with .Note}} · {{.}}{{end}}{{end}}
        <span class="phase-at ml-auto normal-case">{{.At}}</span>
      </header>
      {{range .Lines}}{{.}}
      {{end -}}
    </section>
    {{end}}
    <div class="run-log-live" hx-ext="sse" sse-connect="{{.Log.StreamPath}}" sse-swap="message" sse-close="end" hx-swap="beforeend"></div>
    {{with .Log.Result}}<p class="run-log-result mt-2">{{.}}</p>{{end}}
  </div>
  {{- if .FollowUpAvailable}}
  <form method="post" action="/verb" hx-post="{{or .VerbPath "/verb"}}" hx-target="#board" hx-swap="outerHTML" class="follow-up mt-3 flex flex-col gap-2">
    <input type="hidden" name="ticket" value="{{.URL}}">
    <input type="hidden" name="verb" value="{{.FollowUpVerb}}">
    <textarea name="prompt" rows="3" placeholder="Send this run a follow-up prompt…" class="w-full"></textarea>
    <button type="submit" class="self-end">send</button>
  </form>
  {{- end}}
</td>
