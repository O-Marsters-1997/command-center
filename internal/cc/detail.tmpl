<td colspan="10" class="detail">
  <dl>
    <dt>base sha</dt><dd>{{.BaselineSHA}}</dd>
    <dt>worktree</dt><dd>{{if .Worktree}}{{.Worktree}}{{else}}no worktree has been cut{{end}}</dd>
    <dt>elapsed</dt><dd>{{if .Elapsed}}{{.Elapsed}}{{else}}not started{{end}}</dd>
    <dt>checks</dt>
    <dd>
      {{- range .Checks}}<div>{{.Name}}: {{.Status}}{{with .Conclusion}} {{.}}{{end}}</div>{{else}}no checks{{end -}}
    </dd>
    {{if .Draft}}<dt>draft</dt><dd>{{.DraftReason}}</dd>{{end}}
    {{if .BaseVerdict}}<dt>base verdict</dt><dd>{{.BaseVerdict}}</dd>{{end}}
    {{if .Warning}}<dt>warning</dt><dd>{{.Warning}}</dd>{{end}}
    <dt>log</dt><dd>{{.LogPath}}</dd>
  </dl>
  <pre hx-ext="sse" sse-connect="{{.LogStream}}" sse-swap="message" sse-close="end" hx-swap="beforeend">
    {{- range .LogTail}}<div>{{.}}</div>{{end -}}
  </pre>
</td>
