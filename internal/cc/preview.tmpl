{{template "docHead" .}}
<body>
{{template "skipLink" .}}
{{template "topbar" .}}
{{template "masthead" .}}
<div class="shell">
{{template "sidebar" .}}
<main id="main" class="p-4">
<h1 class="mb-3">LAUNCH</h1>
<form method="post" action="/launch">
<table class="w-full max-w-4xl mb-3">
  <tr>
    <th></th><th>label</th><th>ticket</th><th>base</th><th>base verdict</th><th>why</th><th>prompt</th>
  </tr>
  {{range .Rows}}
  <tr>
    <td>{{if not .Refused}}<input type="checkbox" name="ticket" value="{{.URL}}" checked><input type="hidden" name="hash" value="{{.URL}} {{.Hash}}">{{end}}</td>
    <td>{{.Label}}</td>
    <td>{{.URL}}</td>
    <td>{{.Base}}</td>
    <td>{{.BaseVerdict}}</td>
    <td class="text-muted">{{.Reason}}</td>
    <td>
      {{- if .Prompt}}
      <details><summary>prompt {{.Hash}}</summary><pre>{{.Prompt}}</pre></details>
      {{- end}}
    </td>
  </tr>
  {{end}}
</table>
<button type="submit">[ authorise ]</button>
</form>
<a href="/">[ cancel ]</a>
</main>
</div>
</body>
</html>
