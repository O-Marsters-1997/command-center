<!doctype html>
<meta charset="utf-8">
<link rel="stylesheet" href="/assets/app.css">
<title>Launch preview</title>
<main class="p-4">
<h1 class="mb-3">LAUNCH</h1>
<form method="post" action="/launch">
<table class="w-full max-w-4xl mb-3">
  <tr class="text-xs font-semibold uppercase tracking-wide text-muted">
    <th class="px-3 py-2"></th><th class="px-3 py-2">label</th><th class="px-3 py-2">ticket</th><th class="px-3 py-2">base</th><th class="px-3 py-2">base verdict</th><th class="px-3 py-2">why</th><th class="px-3 py-2">prompt</th>
  </tr>
  {{range .}}
  <tr>
    <td>{{if not .Refused}}<input type="checkbox" name="task" value="{{.URL}}" checked><input type="hidden" name="hash" value="{{.URL}} {{.Hash}}">{{end}}</td>
    <td>{{.Label}}</td>
    <td>{{.URL}}</td>
    <td>{{.Base}}</td>
    <td>{{.BaseVerdict}}</td>
    <td class="text-muted">{{.Reason}}</td>
    <td>
      {{- if .Prompt}}
      <details><summary>prompt {{.Hash}}</summary><pre>{{.Prompt}}</pre></details>
      {{- end}}
    </td>
  </tr>
  {{end}}
</table>
<button type="submit">[ authorise ]</button>
</form>
<a href="/" class="mt-2 inline-block">[ cancel ]</a>
</main>
