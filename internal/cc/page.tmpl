<!doctype html>
<meta charset="utf-8">
<title>Command Centre</title>
<h1>Command Centre</h1>
<p>Last successful observe: {{.ObserveAge}}</p>
{{with .LastError}}<p>Last tick error ({{.Age}}): {{.Message}}</p>{{end}}
<table>
  <tr><th>ticket</th><th>state</th><th>why</th><th>branch</th><th>base</th><th>worktree</th><th>pr</th></tr>
  {{range .Rows}}
  <tr>
    <td>{{.TicketURL}}</td>
    <td>{{.State}}</td>
    <td>{{.Reason}}</td>
    <td>{{.Branch}}</td>
    <td>{{.Base}}</td>
    <td>{{.Worktree}}</td>
    <td>{{.PR}}</td>
  </tr>
  {{end}}
</table>
