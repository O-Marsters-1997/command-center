<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Command Centre</title>
<link rel="stylesheet" href="/assets/app.css">
<script>
  var stored = localStorage.getItem("theme");
  var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  document.documentElement.dataset.theme = stored || (dark ? "dark" : "light");
  function toggleTheme() {
    var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  }
</script>
<script src="/assets/htmx.min.js"></script>
<script src="/assets/sse.min.js"></script>
<script>
  document.addEventListener("htmx:sseMessage", function (e) {
    var pre = e.target;
    while (pre.childElementCount > 1000) pre.firstElementChild.remove();
  });
</script>
</head>
<body>
<a class="absolute left-[-100vw] px-2.5 py-1.5 bg-bg focus:left-2 focus:top-2" href="#board">skip to the board</a>
<div id="masthead" hx-swap-oob="true">
  <header class="flex flex-wrap items-center gap-3 py-2 px-4 border-b border-border">
    <h1 class="m-0">Command Centre</h1>
    {{with .Workspace}}<span class="text-muted text-sm">{{.}}</span>{{end}}
    <span class="pill"{{if .LiveAgents}} data-tone="live"{{end}}>
      <span class="{{if .LiveAgents}}pill-pulse{{else}}pill-ring{{end}}"></span>{{.LiveAgents}} live
    </span>
    {{if .ObserveStale}}
    <span class="pill" data-tone="wait"><span class="pill-ring"></span>last good observe: {{.ObserveAge}}</span>
    {{else}}
    <span class="pill"><span class="pill-disc"></span>observed {{.ObserveAge}}</span>
    {{end}}
    <nav class="flex gap-1.5">
      <a class="py-0.5 px-2 border border-border rounded-full text-muted no-underline aria-[current=page]:border-s-live aria-[current=page]:text-fg aria-[current=page]:font-semibold" href="/?view=board"{{if eq .View "board"}} aria-current="page"{{end}}>board</a>
      <a class="py-0.5 px-2 border border-border rounded-full text-muted no-underline aria-[current=page]:border-s-live aria-[current=page]:text-fg aria-[current=page]:font-semibold" href="/?view=graph"{{if eq .View "graph"}} aria-current="page"{{end}}>graph</a>
    </nav>
    <button type="button" class="ml-auto" onclick="toggleTheme()">theme</button>
  </header>
  {{with .LastError}}
  <p class="banner ribbon" data-tone="stop" role="status">
    the last tick failed {{.Age}} and nothing below has been re-derived since. {{.Message}}
  </p>
  {{end}}
</div>
<main>
{{template "band" .}}
{{if eq .View "graph"}}
<!-- noShadowDOM() is cc-graph's first statement (ADR 2), so this fallback content is what a
     Go-only build with no Node -- assets/dist/graph.js never built, the script below 404s --
     renders: a custom element the browser never upgrades still shows its light-DOM children. -->
<cc-graph>
  <p class="banner ribbon" data-tone="wait" role="status">
    the dependency graph needs the built assets: run `just assets`, or switch to the board view.
  </p>
</cc-graph>
<script type="module" src="/assets/dist/graph.js"></script>
{{else}}
<!-- Empty, and outside the table on purpose: a launch authorises a whole slice at once, so its
     checkboxes sit in the rows and join this form by form="launch". Wrapping the table in it
     instead would nest the per-row verb forms inside it, which HTML forbids. -->
<form id="launch" method="get" action="/preview"></form>
{{template "board" .}}
<button type="submit" form="launch">launch selected</button>
{{end}}
</main>
</body>
</html>
