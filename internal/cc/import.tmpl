<!doctype html>
<meta charset="utf-8">
<link rel="stylesheet" href="/assets/app.css">
<title>Import</title>
<main class="p-4">
<h1 class="mb-3">IMPORT</h1>
{{range .}}
<h2 class="mt-4 mb-2 text-base font-bold">{{.Group}}</h2>
<form method="post" action="/import">
<input type="hidden" name="group" value="{{.Group}}">
<table class="w-full max-w-3xl">
  <tr class="text-xs font-semibold uppercase tracking-wide text-muted"><th class="px-3 py-2">ticket</th><th class="px-3 py-2">title</th><th class="px-3 py-2">status</th></tr>
  {{range .Tickets}}
  <tr><td class="px-3 py-2 break-all">{{.URL}}</td><td class="px-3 py-2">{{.Title}}</td><td class="px-3 py-2">{{.Status}}</td></tr>
  {{end}}
</table>
<button type="submit" class="mt-2">[ import {{len .Tickets}} ]</button>
</form>
{{else}}
<p class="text-muted">no project: labels found across the configured repos.</p>
{{end}}
<a href="/" class="mt-2 inline-block">[ back ]</a>
</main>
