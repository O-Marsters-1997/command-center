<!doctype html>
<meta charset="utf-8">
<link rel="stylesheet" href="/assets/app.css">
<title>Import</title>
<main class="p-4">
<h1 class="mb-3">IMPORT</h1>
{{with .LastImportError}}
<p class="banner ribbon mb-2" data-tone="stop" role="status">
  import of {{.Feature}} refused {{.Age}}. {{.Message}}
</p>
{{end}}
{{range .Features}}
<h2 class="mt-4 mb-2 text-base font-bold">{{.Feature}}</h2>
<form method="post" action="/import">
<input type="hidden" name="feature" value="{{.Feature}}">
<table class="w-full max-w-3xl">
  <tr><th>ticket</th><th>title</th><th>status</th></tr>
  {{range .Tickets}}
  <tr><td class="break-all">{{.URL}}</td><td>{{.Title}}</td><td>{{.Status}}</td></tr>
  {{end}}
</table>
<button type="submit" class="mt-2">[ import {{len .Tickets}} ]</button>
</form>
{{else}}
<p class="text-muted">no project: labels found across the configured repos.</p>
{{end}}
<a href="/" class="mt-2 inline-block">[ back ]</a>
</main>
