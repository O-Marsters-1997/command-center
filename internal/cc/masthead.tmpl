{{define "age"}}{{if .Stamp}}<time datetime="{{.Stamp}}">{{.Age}}</time>{{else}}{{.Age}}{{end}}{{end}}

{{define "masthead" -}}
<div id="masthead" hx-swap-oob="true">
  <div class="flex flex-wrap items-center gap-[0.6rem] py-2 px-4">
    <span class="pill"{{if .LiveAgents}} data-tone="live"{{end}}>
      <span class="{{if .LiveAgents}}pill-pulse{{else}}pill-ring{{end}}"></span>{{.LiveAgents}} live
    </span>
    {{if .ObserveStale}}
    <span class="pill" data-tone="wait"><span class="pill-ring"></span>last good observe: {{template "age" .Observe}}</span>
    {{else}}
    <span class="pill"><span class="pill-disc"></span>observed {{template "age" .Observe}}</span>
    {{end}}
  </div>
  {{with .LastError}}
  <p class="banner ribbon" data-tone="stop" role="status">
    the last tick failed {{template "age" .Age}} and nothing below has been re-derived since. {{.Message}}
  </p>
  {{end}}
</div>
{{- end}}
