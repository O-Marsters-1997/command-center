{{template "docHead" .}}
<body>
{{template "skipLink" .}}
{{template "topbar" .}}
{{template "masthead" .}}
<div class="shell">
{{template "sidebar" .}}
<main id="main" class="p-4">
<h1 class="mb-3">FEATURES</h1>
{{with .LastImportError}}
<p class="banner ribbon mb-2" data-tone="stop" role="status">
  import of {{.Feature}} refused {{.Age}}. {{.Message}}
</p>
{{end}}
<form method="get" action="/features" class="mb-3">
<input type="search" name="q" value="{{.Query}}" placeholder="filter by name" class="border border-border rounded px-2 py-1">
</form>
<table class="w-full max-w-3xl">
  <tr><th>feature</th><th>imported</th><th></th></tr>
  {{range .Features}}
  <tr>
    <td><a href="/features/{{.Feature | pathEscape}}">{{.Feature}}</a></td>
    <td>{{if .Imported}}yes{{else}}no{{end}}</td>
    <td>
      <form hx-post="/launch/open" hx-target="#launch-modal" hx-swap="innerHTML">
        <input type="hidden" name="feature" value="{{.Feature}}">
        <button type="submit">[ launch ]</button>
      </form>
      {{if .Imported}}
      <form method="post" action="/features/{{.Feature | pathEscape}}/import">
        <button type="submit">[ reimport ]</button>
      </form>
      {{end}}
    </td>
  </tr>
  {{else}}
  <tr><td colspan="3" class="text-muted">no project: labels found across the configured repos.</td></tr>
  {{end}}
</table>
<a href="/" class="mt-2 inline-block">[ back ]</a>
<div id="launch-modal"></div>
</main>
</div>
</body>
</html>
