{{define "reposTable" -}}
<table id="repos-table" class="w-full max-w-3xl">
  <tr><th>repo</th><th>state</th><th></th></tr>
  {{range .Repos}}
  <tr>
    <td><a href="{{.ScopePath}}">{{.Name}}</a></td>
    <td>
      <span class="pill" data-tone="{{.Tone}}">
        {{if .Tracked}}<span class="pill-disc"></span>{{else}}<span class="pill-ring"></span>{{end}}{{.State}}
      </span>
    </td>
    <td>{{if not .Tracked}}<a href="{{.ScopePath}}">track &rarr;</a>{{end}}</td>
  </tr>
  {{else}}
  <tr><td colspan="3" class="text-muted">no repos match.</td></tr>
  {{end}}
</table>
{{- end}}

{{template "docHead" .}}
<body>
{{template "skipLink" .}}
{{template "topbar" .}}
{{template "masthead" .}}
<div class="shell">
{{template "sidebar" .}}
<main id="main" class="p-4">
{{if .Scoped}}
<h1 class="mb-1">{{.RepoName}}</h1>
{{if .RepoKnown}}
<p class="text-muted mb-3">{{.RepoRemote}} &middot; <a href="{{.BoardPath}}">board &rarr;</a></p>
{{else}}
<p class="banner ribbon mb-3" data-tone="idle" role="status">Not tracked.</p>
{{end}}
<form class="mb-3">
<input type="search" name="q" placeholder="find a repo" hx-get="/features/search" hx-trigger="input changed delay:300ms" hx-target="#repo-search-results" hx-swap="innerHTML" class="border border-border rounded px-2 py-1">
</form>
<div id="repo-search-results"></div>
{{if .RepoKnown}}
{{with .LastImportError}}
<p class="banner ribbon mb-2" data-tone="stop" role="status">
  import of {{.Feature}} refused {{.Age}}. {{.Message}}
</p>
{{end}}
<table class="w-full max-w-3xl">
  <tr><th>feature</th><th>imported</th><th></th></tr>
  {{range .Features}}
  <tr>
    <td>
      <a href="/features/{{.Feature | pathEscape}}">{{.Feature}}</a>
      {{if .OtherRepos}}<p class="text-muted">also in {{.OtherRepos | join}}</p>{{end}}
    </td>
    <td>{{if .Imported}}yes{{else}}no{{end}}</td>
    <td>
      <form hx-post="/launch/open" hx-target="#launch-modal" hx-swap="innerHTML">
        <input type="hidden" name="feature" value="{{.Feature}}">
        <button type="submit">[ launch ]</button>
      </form>
      {{if .Imported}}
      <form method="post" action="/features/{{.Feature | pathEscape}}/import">
        <button type="submit">[ reimport ]</button>
      </form>
      {{end}}
    </td>
  </tr>
  {{else}}
  <tr><td colspan="3" class="text-muted">no project: labels found in this repo's tracker.</td></tr>
  {{end}}
</table>
{{end}}
{{else}}
<h1 class="mb-3">REPOS</h1>
{{with .LastImportError}}
<p class="banner ribbon mb-2" data-tone="stop" role="status">
  import of {{.Feature}} refused {{.Age}}. {{.Message}}
</p>
{{end}}
<form class="mb-1">
<input type="search" name="q" placeholder="find a repo" hx-get="/features/search" hx-trigger="input changed delay:300ms" hx-target="#repos-table" hx-swap="outerHTML" class="border border-border rounded px-2 py-1 w-full max-w-3xl">
</form>
<p class="text-muted mb-3">search runs as this box's own gh identity.</p>
{{template "reposTable" .}}
{{end}}
<div id="launch-modal"></div>
</main>
</div>
</body>
</html>
