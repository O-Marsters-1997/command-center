{{define "board" -}}
<table id="board" hx-get="{{.BoardPath}}" hx-trigger="every 5s" hx-swap="outerHTML">
  <tr>
    <th>ticket</th><th>state</th><th>why</th><th>verbs</th><th>branch</th><th>base</th><th>base verdict</th>
    <th>stack depth</th><th>merge order</th><th>warning</th>
    <th>worktree</th><th>pr</th><th>pgid</th><th>elapsed</th><th>log</th>
    <th>draft</th><th>draft reason</th><th>detail</th>
  </tr>
  {{range $group := .Groups}}
  {{if $group.Root}}
  {{template "row" (head $group.Root)}}
  {{range $group.Children}}{{template "row" (child . 1)}}{{end}}
  {{else}}
  {{range $group.Children}}{{template "row" (child . 0)}}{{end}}
  {{end}}
  {{end}}
</table>
{{- end}}

{{define "row"}}
  <tr{{if .Head}} class="group-head"{{end}} data-depth="{{.Depth}}">
    <td>{{.Ticket}}{{with .Title}} {{.}}{{end}}</td>
    <td>{{.State}}{{range .PendingVerbs}} · {{.}} queued{{end}}</td>
    <td>{{.Reason}}</td>
    <td>
      {{- $row := .}}
      {{- range .Verbs}}
      {{- if eq . $row.LaunchVerb}}
      <input type="checkbox" form="launch" name="task" value="{{$row.URL}}"{{if $row.Checked}} checked{{end}}
        hx-get="{{$row.TogglePath}}" hx-push-url="{{$row.TogglePush}}" hx-target="#board" hx-swap="outerHTML">{{.}}
      {{- else if destructive .}}
      <form method="get" action="/confirm">
        <input type="hidden" name="task" value="{{$row.URL}}">
        <button type="submit" name="verb" value="{{.}}">{{.}}</button>
      </form>
      {{- else}}
      <form method="post" action="/verb">
        <input type="hidden" name="task" value="{{$row.URL}}">
        <button type="submit" name="verb" value="{{.}}">
          {{- .}}{{if eq . $row.CancelVerb}} launch ({{$row.CancelCount}} tickets){{end -}}
        </button>
      </form>
      {{- end}}
      {{- end -}}
    </td>
    <td>{{.Branch}}</td>
    <td>{{.Base}}</td>
    <td>{{.BaseVerdict}}</td>
    <td>{{.StackDepth}}</td>
    <td>{{.MergeOrder}}</td>
    <td>{{.Warning}}</td>
    <td>{{.Worktree}}</td>
    <td>{{.PR}}</td>
    <td>{{.Pgid}}</td>
    <td>{{.Elapsed}}</td>
    <td>{{.LogPath}}</td>
    <td>{{.Draft}}</td>
    <td>{{.DraftReason}}</td>
    <td>
      <button type="button" hx-get="{{.SelectPath}}" hx-push-url="{{.SelectPush}}" hx-target="#board" hx-swap="outerHTML">detail</button>
    </td>
  </tr>
  {{if .Selected}}
  <!-- hx-preserve keeps an expanded detail mounted through the board's own swap, which would
       otherwise destroy and remount it every five seconds. Only the selected row ever renders
       this <tr>: htmx matches hx-preserve by id off the incoming markup, so an unselected row
       must render none at all rather than an empty one for a later selection to fill
       (docs/prds/prd-fleet-view.md § The hx-preserve id is conditional on selection). -->
  <tr id="{{.DetailID}}" hx-preserve="true">{{template "detail" .}}</tr>
  {{end}}
{{end}}
