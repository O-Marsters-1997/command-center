{{define "board" -}}
<table id="board" hx-get="{{.BoardPath}}" hx-trigger="every 5s" hx-swap="outerHTML">
  <tr>
    <th></th><th>state</th><th>ticket</th><th>task</th><th>stack</th>
    <th>checks</th><th>pr</th><th>elapsed</th><th>spend</th><th>verbs</th>
  </tr>
  {{range $group := .Groups}}
  {{if $group.Root}}
  {{template "row" (head $group.Root)}}
  {{range $group.Children}}{{template "row" (child . 1)}}{{end}}
  {{else}}
  {{range $group.Children}}{{template "row" (child . 0)}}{{end}}
  {{end}}
  {{end}}
</table>
{{- end}}

{{define "row"}}
  <tr class="group{{if .Head}} group-head bg-[color-mix(in_oklab,var(--color-border)_40%,var(--color-bg))] text-muted{{end}}{{if .Selected}} selected{{end}}" data-depth="{{.Depth}}">
    <td>
      {{- $row := .}}
      {{- range .Verbs}}
      {{- if eq . $row.LaunchVerb}}
      <input type="checkbox" form="launch" name="task" value="{{$row.URL}}"{{if $row.Checked}} checked{{end}}
        hx-get="{{$row.TogglePath}}" hx-push-url="{{$row.TogglePush}}" hx-target="#board" hx-swap="outerHTML">
      {{- end}}
      {{- end -}}
    </td>
    <td>
      <span class="pill pill-{{.Tone}}{{if .Unattended}} pill-disc{{else}} pill-ring{{end}}{{if .Alive}} pill-pulse{{end}}">{{.State}}</span>
      {{- if .Draft}} <mark class="flag" title="draft: {{.DraftReason}}">draft</mark>{{end}}
      {{- if .BaseVerdict}} <mark class="flag" title="base verdict: {{.BaseVerdict}}">base {{.BaseVerdict}}</mark>{{end}}
      {{- if .Warning}} <mark class="flag flag-warning" title="{{.Warning}}">⚠ ready-to-merge</mark>{{end}}
      {{- range .PendingVerbs}} · {{.}} queued{{end}}
    </td>
    <td>
      <button type="button" class="border-none bg-transparent p-0 text-inherit underline underline-offset-2" hx-get="{{.SelectPath}}" hx-push-url="{{.SelectPush}}" hx-target="#board" hx-swap="outerHTML">{{.Ticket}}</button>
    </td>
    <td>
      {{- if .Reason}}<div class="text-muted text-[0.85em]">{{.Reason}}</div>{{end}}
      <div>{{if .Title}}{{.Title}}{{else}}untitled{{end}}</div>
    </td>
    <td>{{.Stack}}</td>
    <td>
      {{- if .Checks}}
      <span class="meter"><span class="meter-fill" style="width: {{percent .ChecksPassed (len .Checks)}}%"></span></span>
      {{.ChecksPassed}}/{{len .Checks}}
      {{- else}}no checks{{end}}
    </td>
    <td>{{if .PRNumber}}#{{.PRNumber}} {{.PRState}}{{else}}no pr{{end}}</td>
    <td>
      {{- if .Elapsed}}
      <span class="meter"><span class="meter-fill" style="width: {{.ElapsedPercent}}%"></span></span>
      {{.Elapsed}}
      {{- else}}not started{{end}}
    </td>
    <td>
      {{- if .SpendSettled}}${{printf "%.2f" .SpendUSD}}
      {{- else if .SpendTokens}}{{.SpendTokens}} tok
      {{- else}}no spend{{end}}
    </td>
    <td class="opacity-35 transition-[opacity] duration-[120ms] ease-[ease-in-out] motion-reduce:transition-none group-hover:opacity-100 group-focus-within:opacity-100 group-[.selected]:opacity-100">
      {{- $row := .}}
      {{- range .Verbs}}
      {{- if eq . $row.LaunchVerb}}
      {{- else if destructive .}}
      <form method="get" action="/confirm">
        <input type="hidden" name="task" value="{{$row.URL}}">
        <button type="submit" name="verb" value="{{.}}">{{.}}</button>
      </form>
      {{- else}}
      <form method="post" action="/verb">
        <input type="hidden" name="task" value="{{$row.URL}}">
        <button type="submit" name="verb" value="{{.}}">
          {{- .}}{{if eq . $row.CancelVerb}} launch ({{$row.CancelCount}} tickets){{end -}}
        </button>
      </form>
      {{- end}}
      {{- end -}}
    </td>
  </tr>
  {{if .Selected}}
  <!-- hx-preserve keeps an expanded detail mounted through the board's own swap, which would
       otherwise destroy and remount it every five seconds. Only the selected row ever renders
       this <tr>: htmx matches hx-preserve by id off the incoming markup, so an unselected row
       must render none at all rather than an empty one for a later selection to fill
       (docs/prds/prd-fleet-view.md § The hx-preserve id is conditional on selection). -->
  <tr id="{{.DetailID}}" hx-preserve="true">{{template "detail" .}}</tr>
  {{end}}
{{end}}
