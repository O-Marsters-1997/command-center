<dialog id="launch-modal-body" open{{if .Pending}} hx-get="/launch/candidates?feature={{.FeatureQuery}}" hx-trigger="load, every 1s" hx-swap="outerHTML"{{end}} class="p-4">
{{if .Pending -}}
<p>importing {{.Feature}}&hellip;</p>
{{- else if .Refused -}}
<p class="banner ribbon" data-tone="stop" role="status">import of {{.Feature}} refused: {{.Refused}}</p>
{{- else if .Empty -}}
<p class="text-muted">{{.Feature}} has no tickets to launch.</p>
{{- else -}}
<!-- noShadowDOM() is cc-launch-modal's first statement (ADR 2), so this fallback content is what
     a Go-only build with no Node -- assets/dist/launch-modal.js never built, the script below
     404s -- renders: a custom element the browser never upgrades still shows its light-DOM
     children. -->
<cc-launch-modal{{if .Feature}} feature="{{.Feature}}"{{else}} tickets="{{.TicketQuery}}"{{end}}>
  <p class="banner ribbon" data-tone="wait" role="status">
    the launch modal needs the built assets: run `just assets`.
  </p>
</cc-launch-modal>
<script type="module" src="/assets/dist/launch-modal.js"></script>
{{- end}}
<a href="{{if .Feature}}/features{{else}}/{{end}}">[ cancel ]</a>
</dialog>
