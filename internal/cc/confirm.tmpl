<!doctype html>
<meta charset="utf-8">
<style>{{css}}</style>
<title>Confirm {{.Verb}}</title>
<h1>Confirm {{.Verb}}</h1>
<p>{{.Verb}} on {{.TicketURL}} {{.Effect}}. It cannot be undone.</p>
<p>{{.RiskLabel}} at risk: {{or .Risk "none recorded"}}</p>
<form method="post" action="/verb">
  <input type="hidden" name="task" value="{{.TicketURL}}">
  <input type="hidden" name="verb" value="{{.Verb}}">
  <button type="submit">[ confirm ]</button>
</form>
<a href="/">back to the board</a>
