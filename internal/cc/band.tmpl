{{define "band" -}}
<section class="mb-3 flex flex-wrap gap-3" aria-label="fleet analytics">
  <article class="flex-[1_1_14rem] rounded-card border border-border bg-surface-raised px-3 py-2">
    <h2 class="m-0 mb-1 text-2xs font-semibold uppercase tracking-wider text-muted">state of the fleet</h2>
    {{if eq .Band.Fleet.Total 0}}
    <p class="m-0 text-muted">no tickets tracked yet</p>
    {{else}}
    <p class="m-0 mb-1 text-headline font-medium">{{.Band.Fleet.Yours}}/{{.Band.Fleet.Total}} yours</p>
    <div class="flex h-2 overflow-hidden rounded-full bg-track">
      {{range .Band.Fleet.Segments}}
      <span class="segbar-segment" data-tone="{{.Tone}}" style="flex-grow: {{.Count}}"></span>
      {{end}}
    </div>
    <ul class="m-0 mt-1.5 flex flex-wrap list-none gap-x-3 gap-y-1 p-0 text-xs text-muted">
      {{range .Band.Fleet.Segments}}
      <li class="flex items-center gap-1"><span class="pill-disc" data-tone="{{.Tone}}"></span>{{.State}} · {{.Count}}</li>
      {{end}}
    </ul>
    {{end}}
  </article>

  <article class="flex-[1_1_14rem] rounded-card border border-border bg-surface-raised px-3 py-2">
    <h2 class="m-0 mb-1 text-2xs font-semibold uppercase tracking-wider text-muted">stack depth</h2>
    {{if not .Band.Stack.HasWorktree}}
    <p class="m-0 text-muted">no worktree has been cut</p>
    {{else}}
    <p class="m-0 mb-1 text-headline font-medium">{{.Band.Stack.Deepest}} deep</p>
    <ul class="m-0 flex flex-col list-none gap-1 p-0 text-xs text-muted">
      {{range .Band.Stack.Bars}}
      <li class="flex items-center gap-1.5">
        <span class="meter"><span class="meter-fill" data-tone="idle" style="width: {{.Pct}}%"></span></span>
        depth {{.Depth}} · {{.Count}}
      </li>
      {{end}}
    </ul>
    {{end}}
  </article>

  <article class="flex-[1_1_14rem] rounded-card border border-border bg-surface-raised px-3 py-2">
    <h2 class="m-0 mb-1 text-2xs font-semibold uppercase tracking-wider text-muted">gating checks</h2>
    {{if eq .Band.Checks.Reported 0}}
    <p class="m-0 text-muted">no branch has reported a check yet</p>
    {{else}}
    <p class="m-0 mb-1 text-headline font-medium">{{.Band.Checks.Green}} green · {{.Band.Checks.Red}} red</p>
    <p class="m-0 text-xs text-muted">{{.Band.Checks.Reported}}/{{.Band.Checks.Total}} branches reported</p>
    {{end}}
  </article>

  <article class="flex-[1_1_14rem] rounded-card border border-border bg-surface-raised px-3 py-2">
    <h2 class="m-0 mb-1 text-2xs font-semibold uppercase tracking-wider text-muted">spend</h2>
    {{if eq .Band.Spend.Count 0}}
    <p class="m-0 text-muted">no runs have completed this session yet</p>
    {{else}}
    <p class="m-0 mb-1 text-headline font-medium">${{printf "%.2f" .Band.Spend.Total}}</p>
    <p class="m-0 text-xs text-muted">{{.Band.Spend.Count}} runs · {{.Band.Spend.Failures}} failed · avg ${{printf "%.2f" .Band.Spend.Average}}</p>
    {{end}}
  </article>
</section>
{{- end}}
