{{define "docHead" -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Command Centre</title>
<link rel="stylesheet" href="/assets/app.css">
<script>
  var stored = localStorage.getItem("theme");
  var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  document.documentElement.dataset.theme = stored || (dark ? "dark" : "light");
  function toggleTheme() {
    var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  }
  // Every <time datetime> is rendered once with the instant it counts from, so the server's own
  // wording goes stale the moment it is sent and a swap is not what keeps it current.
  function ago(ms) {
    var s = Math.max(0, Math.round(ms / 1000));
    if (s < 60) return s + "s ago";
    var m = Math.floor(s / 60);
    if (m < 60) return m + "m" + (s % 60 ? (s % 60) + "s" : "") + " ago";
    var h = Math.floor(m / 60);
    return h + "h" + (m % 60 ? (m % 60) + "m" : "") + " ago";
  }
  setInterval(function () {
    var now = Date.now();
    document.querySelectorAll("time[datetime]").forEach(function (el) {
      var at = Date.parse(el.dateTime);
      if (!isNaN(at)) el.textContent = ago(now - at);
    });
  }, 1000);
</script>
<script src="/assets/htmx.min.js"></script>
<script src="/assets/sse.min.js"></script>
<script>
  document.addEventListener("htmx:sseMessage", function (e) {
    var pre = e.target;
    while (pre.childElementCount > 1000) pre.firstElementChild.remove();
  });
</script>
</head>
{{- end}}

{{define "topbar" -}}
<header class="flex flex-wrap items-center gap-[0.6rem] py-2 px-4 border-b border-border">
  <h1 class="m-0">Command Centre</h1>
  {{with .Workspace}}<span class="text-muted">{{.}}</span>{{end}}
  <nav class="flex gap-[0.4rem]">
    <a class="py-[0.1rem] px-2 border border-border rounded-full text-muted no-underline aria-[current=page]:border-s-live aria-[current=page]:text-fg" href="/?view=board"{{if eq .View "board"}} aria-current="page"{{end}}>board</a>
    <a class="py-[0.1rem] px-2 border border-border rounded-full text-muted no-underline aria-[current=page]:border-s-live aria-[current=page]:text-fg" href="/?view=graph"{{if eq .View "graph"}} aria-current="page"{{end}}>graph</a>
  </nav>
  {{if .RepoLinks}}
  <nav class="flex gap-[0.4rem]">
    {{range .RepoLinks}}
    <a class="py-[0.1rem] px-2 border border-border rounded-full text-muted no-underline aria-[current=page]:border-s-live aria-[current=page]:text-fg" href="{{.Path}}"{{if .Current}} aria-current="page"{{end}}>{{.Name}}</a>
    {{end}}
  </nav>
  {{end}}
  {{if .FeatureLinks}}
  <nav class="flex gap-[0.4rem]">
    {{range .FeatureLinks}}
    <a class="py-[0.1rem] px-2 border border-border rounded-full text-muted no-underline aria-[current=page]:border-s-live aria-[current=page]:text-fg" href="{{.Path}}"{{if .Current}} aria-current="page"{{end}}>{{.Name}}</a>
    {{end}}
  </nav>
  {{end}}
  {{if .FeatureImportPath}}
  <form hx-post="{{.FeatureImportPath}}" hx-target="#board" hx-swap="outerHTML">
    <button type="submit" class="py-[0.1rem] px-2 border border-border rounded-full text-muted">reimport</button>
  </form>
  {{end}}
  <a class="py-[0.1rem] px-2 border border-border rounded-full text-muted no-underline" href="/features">features</a>
  <button type="button" class="ml-auto" onclick="toggleTheme()">theme</button>
</header>
{{- end}}
