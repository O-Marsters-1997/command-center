# Two configured repos each holding a ticket cut to the identical branch name -- "cc-1-x", since
# both are issue #1 titled "x" -- stop contaminating each other's Observation facts (issue #217,
# docs/adr/0003-seams-are-removed.md's prerequisite: "the plain name would collide the moment a
# second repo is configured"). Before the fix, Observation's branch-keyed maps are indexed by the
# bare branch name, so the second repo's own per-tick write clobbers the first's. This script pins
# the fix: each ticket's own row must derive from its own repo's worktree, never its neighbour's.

cc-init-repo
cc-init-repo peer
cc-config same-branch-two-repos
cc-fake-gh same-branch-two-repos

exec cc import project:same-branch
exec cc tick --count 1
exec cc request POST '/launch?ticket=https://github.com/sandbox-org/repo/issues/CC-1&ticket=https://github.com/sandbox-org/peer/issues/CC-1'
exec cc tick --count 1
exec sleep 0.5

# Both cut and spawn this tick, onto the identical branch name in their own separate checkouts.
exec cc tick --count 1
grep -count=2 'new cc-1-x --base origin/main' $WORK/tp.log

exec sleep 0.5

# A fresh observe reads both repos' own worktree back under the same bare branch name.
exec cc tick --count 1

# Each ticket's own row must derive from its own repo's worktree, so both read the same state
# rather than one of them losing its neighbour's.
exec cc request GET /tickets
stdout -count=2 '>push_pending</span>'
