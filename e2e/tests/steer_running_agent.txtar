cc-init-repo
cc-config steers
cc-fake-gh no-prs

exec cc import project:single-task
exec cc tick --count 1
exec cc request POST '/launch?ticket=https://github.com/sandbox-org/single-task/issues/CC-1'
exec cc tick --count 1
exec cc tick --count 1
cc-wait agent.log 'steers.sh session-id'
exec cc tick --count 1

exec cc request GET /tickets
stdout -count=1 '>running</span>'
grep -count=1 '(?m)^steers.sh session-id [0-9a-f-]{36}$' $WORK/agent.log
! grep 'resume' $WORK/agent.log

exec cc request -form 'verb=follow-up&ticket=https://github.com/sandbox-org/single-task/issues/CC-1&prompt=use+sqlite' POST /verb
exec cc tick --count 1
cc-wait agent-done.log 'steers.sh resume'

grep -count=1 '(?m)^steers.sh resume [0-9a-f-]{36}$' $WORK/agent.log
exec sh -c 'test "$(sed -E "s/^steers.sh [a-z-]+ //" $WORK/agent.log | sort -u | wc -l)" -eq 1'
