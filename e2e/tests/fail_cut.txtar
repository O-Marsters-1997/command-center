# tp new fails: the row derives cut_failed, and it derives it once. `cut failed` is a terminal
# state with no worktree and no pgid, ever (docs/prd-command-centre.md § The states), so the
# assertion this script exists for is the *count* -- exactly one tp new attempt across four
# ticks. A cut that retried every tick would still show the same state on the page while
# hammering tp forever, which is the failure a state-only assertion cannot see.

cc-init-repo
cc-config single-task-commits
cc-fake-gh no-prs

exec cc tick --count 1

# faketp logs its argv before it reads CC_TP_FAIL, so a failed cut is still a logged attempt.
env CC_TP_FAIL=1
exec cc request POST '/launch?task=sandbox://CC-1'
exec cc tick --count 1

exec cc request GET /
stdout -count=1 '<td>cut_failed</td>'
stdout 'tp new failed to cut a worktree'
grep -count=1 'new cc-1' $WORK/tp.log

# The cut-failed run counts as this task's prior run, so job 3 never picks it up again: three
# more ticks, still one attempt.
exec cc tick --count 3
grep -count=1 'new cc-1' $WORK/tp.log
exec cc request GET /
stdout -count=1 '<td>cut_failed</td>'

# No worktree was left behind, and no run ever claimed a pgid: the agent was never spawned, so
# there was never a process to reap.
! exists $WORK/repo-cc-1
! exists $WORK/agent.log
exec cc request GET /events
! stdout 'run_launched'
