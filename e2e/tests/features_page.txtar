# GET /features lists the known repos; GET /features?repo= lists that repo's tracker's features,
# imported or not; opening one 303s to the board scoped to it. GET /import and POST /import no longer exist.

cc-init-repo
cc-config two-tasks
cc-fake-gh no-prs

exec cc request GET /features
stdout 'href="/features\?repo=sandbox-org/two-tasks"'

exec cc tick --count 1

exec cc request GET '/features?repo=sandbox-org/two-tasks'
stdout 'project:two-tasks</a>\s*</td>\s*<td>no</td>'

exec cc import project:two-tasks
exec cc tick --count 1

exec cc request GET '/features?repo=sandbox-org/two-tasks'
stdout 'project:two-tasks</a>\s*</td>\s*<td>yes</td>'

exec cc request GET '/features/project:two-tasks'
stdout 'href="/\?feature=project%3Atwo-tasks"'

exec cc request GET '/?feature=project%3Atwo-tasks'
stdout '>#CC-1</button>'
stdout '>#CC-2</button>'

! exec cc request GET /import
stderr '404'
! exec cc request POST /import
stderr '404'
