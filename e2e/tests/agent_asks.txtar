cc-init-repo
cc-config asks
cc-fake-gh no-prs

exec cc import project:single-task
exec cc tick --count 1
exec cc request POST '/launch?ticket=https://github.com/sandbox-org/single-task/issues/CC-1'
exec cc tick --count 1
exec sleep 0.5
exec cc tick --count 1
exec sleep 0.5
exec cc tick --count 1

exec cc request GET /tickets
stdout -count=1 '>awaiting_input</span>'
stdout 'Which database\?'
! exec git -C $WORK/remote.git rev-parse --verify refs/heads/cc-1-x

exec cc request GET /rail
stdout 'class="rail-reason rail-question">Which database\?'
stdout '>Reply</a>'
! stdout 'value="re-run"'

exec cc request GET /s/sandbox-org/single-task/CC-1
stdout 'class="line line-ask"'
stdout 'Postgres or SQLite\.'
stdout '>Reply</button>'

exec cc request -form 'verb=follow-up&ticket=https://github.com/sandbox-org/single-task/issues/CC-1&prompt=Postgres' POST /verb
exec cc tick --count 1
exec sleep 0.5

grep -count=1 '(?m)^asks.sh session-id [0-9a-f-]{36}$' $WORK/agent.log
grep -count=1 '(?m)^asks.sh resume [0-9a-f-]{36}$' $WORK/agent.log
exec sh -c 'test "$(sed -E "s/^asks.sh [a-z-]+ //" $WORK/agent.log | sort -u | wc -l)" -eq 1'
