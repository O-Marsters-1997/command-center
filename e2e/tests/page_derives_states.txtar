# One tick against a repo with no pull requests, then the page derived from it: the root task
# is ready, the dependent one is blocked and names its blocker.

cc-init-repo
cc-config two-tasks
cc-fake-gh no-prs

exec cc request -form 'group=project:two-tasks' POST /import
exec cc tick --count 1
exec cc request GET /

stdout '>#CC-1</button>'
stdout '>ready</span>'
stdout '>#CC-2</button>'
stdout '>blocked</span>'
stdout 'blocked by https://github.com/sandbox-org/two-tasks/issues/CC-1'
