# A row's detail without leaving the board: ?sel= names the one expanded row, the board renders
# it inline, and the fragment carries the facts the board row itself was derived from. htmx is
# served out of the binary, so the page needs no network. The deleted per-row route is a 404.

cc-init-repo
cp mergify-v1.yml repo/.mergify.yml
exec git -C $WORK/repo add .mergify.yml
exec git -C $WORK/repo commit -q -m 'add mergify config'
exec git -C $WORK/repo push -q origin main

cc-config verdict-single-task
cc-fake-gh no-prs

exec cc request -form 'group=project:single-task' POST /import
exec cc tick --count 1
exec cc request POST '/launch?task=https://github.com/sandbox-org/single-task/issues/CC-1'
exec cc tick --count 1
exec sleep 0.5
exec cc tick --count 1

# A PR carrying one real check, so the fragment's check list has something to carry.
cc-fake-gh-head verdict-one-red cc-1-x
exec cc tick --count 1

# The board links each row to its own selection, and loads htmx locally.
exec cc request GET /
stdout '<script src="/assets/htmx.min.js"></script>'
stdout 'hx-get="/board\?sel=https%3A%2F%2Fgithub.com%2Fsandbox-org%2Fsingle-task%2Fissues%2FCC-1"'
! stdout 'http-equiv="refresh"'
! stdout 'hx-preserve'

exec cc request GET /assets/htmx.min.js
stdout 'htmx'

# ?sel= names the ticket whose facts the fragment carries: the check GitHub reported, the
# worktree on disk, the run's baseline commit and its log.
exec cc request GET '/?sel=https%3A%2F%2Fgithub.com%2Fsandbox-org%2Fsingle-task%2Fissues%2FCC-1'
stdout '<div>CI: COMPLETED FAILURE</div>'
stdout '<dt>worktree</dt><dd>.*/repo-cc-1-x</dd>'
stdout '<dt>base sha</dt><dd>[0-9a-f]{40}</dd>'
stdout '<span class="run-log-path">.*/runs/1\.jsonl</span>'
stdout '<dt>elapsed</dt>'
stdout 'hx-preserve="true"'

# The deleted per-row route is gone outright, under either name.
! exec cc request GET /ticket/sandbox:%2F%2FCC-1/detail
stderr '404'
! exec cc request GET /task/sandbox:%2F%2FCC-1/detail
stderr '404'

-- mergify-v1.yml --
queue_rules: []
pull_request_rules: []
