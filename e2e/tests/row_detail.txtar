# A row's detail without leaving the board: the ticket URL percent-encoded into one path
# segment, and the fragment carrying the facts the board row itself was derived from. htmx is
# served out of the binary, so the page needs no network. An unknown task is a 404.

cc-init-repo
cp mergify-v1.yml repo/.mergify.yml
exec git -C $WORK/repo add .mergify.yml
exec git -C $WORK/repo commit -q -m 'add mergify config'
exec git -C $WORK/repo push -q origin main

cc-config verdict-single-task
cc-fake-gh no-prs

exec cc tick --count 1
exec cc request POST '/launch?task=sandbox://CC-1'
exec cc tick --count 1
exec sleep 0.5
exec cc tick --count 1

# A PR carrying one real check, so the fragment's check list has something to carry.
cc-fake-gh-head verdict-one-red cc-1
exec cc tick --count 1

# The board links each row to its own detail, and loads htmx locally.
exec cc request GET /
stdout '<script src="/assets/htmx.min.js"></script>'
stdout 'hx-get="/task/sandbox:%2F%2FCC-1/detail"'
! stdout 'http-equiv="refresh"'

exec cc request GET /assets/htmx.min.js
stdout 'htmx'

# The percent-encoded ticket URL resolves to that task's own facts: the check GitHub reported,
# the worktree on disk, the run's baseline commit and its log.
exec cc request GET /task/sandbox:%2F%2FCC-1/detail
stdout '<div>CI: COMPLETED FAILURE</div>'
stdout '<dt>worktree</dt><dd>.*/repo-cc-1</dd>'
stdout '<dt>base sha</dt><dd>[0-9a-f]{40}</dd>'
stdout '<dt>log</dt><dd>.*/runs/1\.jsonl</dd>'
stdout '<dt>elapsed</dt>'

! exec cc request GET /task/sandbox:%2F%2FNOPE/detail
stderr '404'

-- mergify-v1.yml --
queue_rules: []
pull_request_rules: []
