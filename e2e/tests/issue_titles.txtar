# Issue #100 end to end: the tick reads each repo's issue titles and the board names its rows by
# them. A title is joined on the ticket URL, so an issue nobody is working on stays off the board
# and a task the read did not cover keeps its number alone.

cc-init-repo
cc-config two-tasks
cc-fake-gh issue-titles

exec cc import project:two-tasks
exec cc tick --count 1
exec cc request GET /tickets

stdout 'data-ref="#CC-1"'
stdout '>Ship the first slice</b>'
stdout 'data-ref="#CC-2"'
! stdout 'An issue nobody is working on'
! stdout '>sandbox://CC-1<'

# A failed issue list fails that repo's observe, not the tick, and the page falls back to the
# repo's last good observation -- titles and all.
cc-fake-gh issue-titles-fail
exec cc tick --count 1

exec cc request GET /tickets
stdout '>Ship the first slice</b>'
exec cc request -hx GET /rail
stdout 'tick failed'
