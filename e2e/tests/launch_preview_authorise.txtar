# The preview for the two-ticket slice reads "now" for the root and "on unlock" for the
# dependent, both bases origin/main (stacking off). POST /launch then one tick leaves both rows
# queued with distinct reasons: one for a slot, one for a base — CC-1 is genuinely cut and
# spawned (agent_command points at the empty.sh fake agent) in that tick, but its liveness is
# read from the observation the tick started with, taken before the spawn happened, so the page
# still shows it queued until the following tick observes it.

cc-init-repo
cc-config two-tasks
cc-fake-gh no-prs

exec cc tick --count 1
exec cc request GET '/preview?task=sandbox://CC-1&task=sandbox://CC-2'
stdout '<td>now</td>'
stdout '<td>on unlock</td>'
stdout '<td>origin/main</td>'
stdout '<button type="submit">\[ authorise \]</button>'

exec cc request POST '/launch?task=sandbox://CC-1&task=sandbox://CC-2'
exec cc tick --count 1
exec cc request GET /

stdout '<td>#CC-1</td>'
stdout '<td>#CC-2</td>'
stdout '<td>queued</td>'
stdout 'waiting for a slot'
stdout 'waiting on sandbox://CC-1&#39;s PR'
