# A fake agent that commits .npmrc is refused outright: the branch stays
# unpushed against the local bare remote, the row reads push_refused naming the path, and the
# refusal lands in events.

cc-init-repo
cc-config single-task-commits-ci
cc-fake-gh no-prs

exec cc import project:single-task
exec cc tick --count 1
exec cc request POST '/launch?ticket=https://github.com/sandbox-org/single-task/issues/CC-1'
exec cc tick --count 1
exec cc tick --count 1
cc-wait agent-done.log 'commits_ci.sh repo-cc-1-x'
exec cc tick --count 1

exec cc request GET /tickets
stdout 'title="Push refused"'
stdout 'push refused: \.npmrc \(\.npmrc\)'

exec cc request GET /events
stdout 'push_refused'
stdout '\.npmrc'

! exec git -C $WORK/remote.git rev-parse --verify refs/heads/cc-1-x
