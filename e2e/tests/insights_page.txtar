# GET /insights renders the limits module and the spend split table inside the shell.

cc-init-repo
cc-config single-task-commits
cc-fake-gh no-prs

exec cc import project:single-task
exec cc tick --count 1

exec cc request GET '/insights'
stdout 'aria-label="limits"'
stdout 'aria-label="spend split"'
stdout 'no merged tickets in range'
