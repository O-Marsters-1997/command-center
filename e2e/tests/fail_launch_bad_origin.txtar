# A POST to /launch with a foreign Origin is rejected by the mux-wide http.CrossOriginProtection,
# so no launches row appears and both tasks stay in their unauthorised states. Every other script's
# plain `cc request POST` (no -origin) carries neither Origin nor Sec-Fetch-Site, which the same
# layer allows -- that's what keeps a non-browser client like cc request working.

cc-init-repo
cc-config two-tasks
cc-fake-gh no-prs

exec cc import project:two-tasks
exec cc tick --count 1
! exec cc request -origin http://evil.example POST '/launch?ticket=https://github.com/sandbox-org/two-tasks/issues/CC-1'
stderr '403'

exec cc tick --count 1
exec cc request GET /
! stdout 'queued'
stdout '>ready</span>'
stdout '>blocked</span>'
