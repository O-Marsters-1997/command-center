# GET /f/{feature} renders the feature's board in attention sections, with the Board/Graph tab pair
# and the one Launch action; an unknown feature is a 404.

cc-init-repo
cc-config two-tasks
cc-fake-gh no-prs

exec cc import project:two-tasks
exec cc tick --count 1
exec cc request GET /f/project:two-tasks

stdout 'data-section="ready"'
stdout '>#CC-1</a>'
stdout '>#CC-2</a>'
stdout 'href="/f/project:two-tasks" aria-current="page">Board<'
stdout 'href="/f/project:two-tasks/graph">Graph<'
stdout 'href="/f/project:two-tasks/launch"'
! stdout 'data-depth'

! exec cc request GET /f/bogus
