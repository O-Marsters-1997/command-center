# An all-green rollup at the commit the app actually pushed derives review_me; swapping one
# check to failure derives ci_failed on the next tick, naming the check that failed; a rollup at
# a foreign head SHA derives checking, never green (docs/designs/command-centre-design.md § 11
# inv. 11). Each of those is also a verdict_transition event -- the last category events needs to
# reconstruct the whole run (Phase 6) -- logged once per change, never repeated while the verdict
# holds steady.

cc-init-repo
cp mergify-v1.yml repo/.mergify.yml
exec git -C $WORK/repo add .mergify.yml
exec git -C $WORK/repo commit -q -m 'add mergify config'
exec git -C $WORK/repo push -q origin main

cc-config verdict-single-task
cc-fake-gh no-prs

exec cc import project:single-task
exec cc tick --count 1
exec cc request POST '/launch?ticket=https://github.com/sandbox-org/single-task/issues/CC-1'
exec cc tick --count 1
exec cc tick --count 1
cc-wait agent-done.log 'commits.sh repo-cc-1-x'
exec cc tick --count 1

cc-fake-gh-head verdict-review-me cc-1-x
exec cc tick --count 1
exec cc tick --count 1
exec cc request GET /tickets
stdout 'title="Ready for review"'
exec cc request GET /events
stdout '"Kind":"verdict_transition","Detail":"review_me'

# A second tick with nothing changed must not repeat the transition.
exec cc tick --count 1
exec cc request GET /events
stdout -count=1 'verdict_transition'

cc-fake-gh-head verdict-one-red cc-1-x
exec cc tick --count 1
exec cc request GET /tickets
stdout 'title="Checks failing"'
stdout 'required check failed: CI'
exec cc request GET /events
stdout -count=2 'verdict_transition'
stdout '"Kind":"verdict_transition","Detail":"ci_failed'

cc-fake-gh verdict-foreign-head
exec cc tick --count 1
exec cc request GET /tickets
! stdout 'title="Ready for review"'
stdout 'title="Waiting on checks"'

-- mergify-v1.yml --
queue_rules: []
pull_request_rules: []
