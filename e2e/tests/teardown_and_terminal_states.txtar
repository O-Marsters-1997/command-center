# Terminal states and teardown (docs/prds/prd-command-centre.md § Phase 6): a merged fixture derives
# merged and remove-worktree closes the ticket's issue, calls faketp remove --merged, and drops
# its row from the board; a closed-unmerged fixture on a row that has run derives base_gone, not
# blocked; remove-worktree refuses a dirty worktree; re-run on a failed row creates a second runs
# row in the same worktree and pushes its commits through the same push step; close-pr derives
# pr_closed_unmerged.

cc-init-repo
cc-config teardown-cc7-empty
cc-fake-gh no-prs
exec cc request -form 'group=project:teardown' POST /import

# CC-7 fails with the empty-commit fake agent: no commits, no push, a plain failed row.
exec cc tick --count 1
exec cc request POST '/launch?task=https://github.com/sandbox-org/teardown/issues/CC-7'
exec cc tick --count 1
exec sleep 0.5
exec cc tick --count 1
exec cc request GET /
stdout '>failed</span>[\s\S]*?>#CC-7</button>'

# Switch the agent to one that actually commits, introduce the root/dependent pair (CC-3/CC-4)
# and the solo CC-1, and re-run CC-7 in its existing worktree -- no second cut.
cc-config teardown-commits
# The group's second import brings in CC-1/CC-3/CC-4 before any verb or launch can name
# them; CC-7 is re-imported too, but its branch/blocked_by, seeded on its first import, are
# left alone.
exec cc request -form 'group=project:teardown-more' POST /import
exec cc tick --count 1
exec cc request POST '/verb?verb=re-run&task=https://github.com/sandbox-org/teardown/issues/CC-7'
exec cc request POST '/launch?task=https://github.com/sandbox-org/teardown/issues/CC-1&task=https://github.com/sandbox-org/teardown/issues/CC-3&task=https://github.com/sandbox-org/teardown/issues/CC-4'
exec cc tick --count 1
grep -count=1 'new cc-7-x' $WORK/tp.log
exec sleep 0.5
exec cc tick --count 1

# CC-7's re-run pushed its commits through the very same push step a fresh launch uses.
exec git -C $WORK/remote.git rev-parse --verify refs/heads/cc-7-x
exec git -C $WORK/remote.git rev-parse --verify refs/heads/cc-1-x
exec git -C $WORK/remote.git rev-parse --verify refs/heads/cc-3-x
exec cc request GET /events
stdout -count=2 '"TicketURL":"https://github.com/sandbox-org/teardown/issues/CC-7","Kind":"run_launched"'
stdout '"TicketURL":"https://github.com/sandbox-org/teardown/issues/CC-7","Kind":"pushed"'

# Swap the fixture: CC-1's PR is now merged, CC-3's is open (which unlocks CC-4), CC-7's is open.
cc-fake-gh teardown-mid
exec cc tick --count 1
exec sleep 0.5
exec cc tick --count 1
exec git -C $WORK/remote.git rev-parse --verify refs/heads/cc-4-x
exec cc request GET /
stdout '>merged</span>[\s\S]*?>#CC-1</button>'

# remove-worktree refuses a dirty worktree: the file is left, nothing is removed.
cp scratch.txt $WORK/repo-cc-1-x/scratch.txt
exec cc request POST '/verb?verb=remove-worktree&task=https://github.com/sandbox-org/teardown/issues/CC-1'
exec cc tick --count 1
exists $WORK/repo-cc-1-x
exec cc request GET /events
stdout '"Kind":"remove_worktree_refused","Detail":".*untracked files'
exec rm $WORK/repo-cc-1-x/scratch.txt

# Cleaned up, the same verb now succeeds: the issue is closed, tp remove --merged tears down the
# worktree, and the ticket's row drops off the board entirely.
exec cc request POST '/verb?verb=remove-worktree&task=https://github.com/sandbox-org/teardown/issues/CC-1'
exec cc tick --count 1
! exists $WORK/repo-cc-1-x
# Twice: the dirty attempt above also reached tp remove --merged, which is what refused it --
# dirty and unpushed are now tp's own checks, not a guard the app runs before calling it.
grep -count=2 'remove --merged cc-1-x' $WORK/tp.log
# Twice too: the issue closes before tp.Remove runs, so the dirty attempt above closed it as
# well -- deliberately, since tp.Remove is the irreversible step and closing an issue twice is a
# no-op, unlike tearing a worktree down with the issue still open and no way back to it.
grep -count=2 'issue close https://github.com/sandbox-org/teardown/issues/CC-1' $WORK/gh.log
exec cc request GET /events
stdout '"TicketURL":"https://github.com/sandbox-org/teardown/issues/CC-1","Kind":"worktree_removed"'
exec cc request GET /
! stdout '>#CC-1</button>'

# CC-3's PR is closed without merging, and close-pr is requested against CC-7's still-open one.
cc-fake-gh teardown-late
exec cc request POST '/verb?verb=close-pr&task=https://github.com/sandbox-org/teardown/issues/CC-7'
exec cc tick --count 1
grep -count=1 'pr close' $WORK/gh.log

# CC-4 has already run (it cut, committed and pushed above), so its blocker's pull request
# closing unmerged derives base_gone -- never blocked (inv. 19).
exec cc request GET /
stdout '>base_gone</span>[\s\S]*?>#CC-4</button>'
! stdout '>blocked</span>[\s\S]*?>#CC-4</button>'

# The fallback read now reports CC-7's own pull request closed too: pr_closed_unmerged, not a
# lingering checking/review_me from before the close.
cc-fake-gh teardown-cc7-closed
exec cc tick --count 1
exec cc request GET /
stdout '>pr_closed_unmerged</span>[\s\S]*?>#CC-7</button>'

-- scratch.txt --
oops
