# The candidate set for the two-ticket slice reads "now" for the root and "on unlock" for the
# dependent, both bases origin/main (stacking off). POST /launch then one tick leaves both rows
# queued with distinct reasons: one for a slot, one for a base — CC-1 is genuinely cut and
# spawned (agent_command points at the empty.sh fake agent) in that tick, but its liveness is
# read from the observation the tick started with, taken before the spawn happened, so the page
# still shows it queued until the following tick observes it.

cc-init-repo
cc-config two-tasks
cc-fake-gh no-prs

exec cc import project:two-tasks
exec cc tick --count 1
exec cc request GET '/launch/candidates?ticket=https://github.com/sandbox-org/two-tasks/issues/CC-1&ticket=https://github.com/sandbox-org/two-tasks/issues/CC-2'
stdout '"label":"now"'
stdout '"label":"on unlock"'
stdout '"base":"origin/main"'

exec cc request POST '/launch?ticket=https://github.com/sandbox-org/two-tasks/issues/CC-1&ticket=https://github.com/sandbox-org/two-tasks/issues/CC-2'
exec cc tick --count 1
exec cc request GET /

stdout '>#CC-1</button>'
stdout '>#CC-2</button>'
stdout '>queued</span>'
stdout 'waiting for a slot'
stdout 'waiting on https://github.com/sandbox-org/two-tasks/issues/CC-1&#39;s PR'
