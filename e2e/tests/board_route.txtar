# GET /board serves the table htmx swaps into its target and nothing else. The shell itself -- the
# document, the launch form -- must not come back down with it.

cc-init-repo
cc-config two-tasks
cc-fake-gh no-prs

exec cc import project:two-tasks
exec cc tick --count 1
exec cc request GET /board?all=1

stdout '^<table id="board"'
stdout '>#CC-1</a>'
stdout '>#CC-2</a>'

! stdout 'hx-swap-oob'

! stdout '<form id="launch"'
! stdout 'launch selected'
! stdout '<!doctype html>'
! stdout '<body>'
