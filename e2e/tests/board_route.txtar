# GET /board serves the table htmx swaps into the target, then the masthead and the band as
# out-of-band swaps, so the numbers above the board never outlive the rows beneath it. The shell
# itself -- the document, the launch form -- must still not come back down with it.

cc-init-repo
cc-config two-tasks
cc-fake-gh no-prs

exec cc request -form 'feature=project:two-tasks' POST /import
exec cc tick --count 1
exec cc request GET /board

stdout '^<table id="board"'
stdout '>#CC-1</button>'
stdout '>#CC-2</button>'

stdout 'id="masthead" hx-swap-oob="true"'
stdout 'id="band" hx-swap-oob="true"'

! stdout '<form id="launch"'
! stdout 'launch selected'
! stdout '<!doctype html>'
! stdout '<body>'
