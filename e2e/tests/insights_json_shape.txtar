# GET /insights.json serves one point per merged ticket plus the withdrawn tickets' waste total:
# the documented top-level fields, and the ticket this script just merged showing up as a point.

cc-init-repo
cc-config single-task-commits
cc-fake-gh no-prs

exec cc import project:single-task
exec cc tick --count 1
exec cc request POST '/launch?ticket=https://github.com/sandbox-org/single-task/issues/CC-1'

# The launch's own reserved explore run cuts and spawns first -- CC-1 stays queued until that
# explore run disposes (ExploreBlocking), brief or not.
exec cc tick --count 1
exec sleep 0.5

# The explore run's dead process disposes, unblocking CC-1 -- it cuts and spawns its own real
# run this same tick.
exec cc tick --count 1
exec sleep 0.5
exec cc tick --count 1

# The human merges (squash) and GitHub deletes the branch.
exec git -C $WORK/repo push -q origin --delete cc-1-x
cc-fake-gh single-task-merged
exec cc tick --count 1

# single-task-merged.json fixes mergedAt at 2020-01-01, well outside the default 30-day range, so
# since= reaches back far enough to include it.
exec cc request GET '/insights.json?since=2019-12-01'
stdout '"since":"2019-12-01"'
stdout '"until":"[0-9]{4}-[0-9]{2}-[0-9]{2}"'
stdout '"timezone":"'
stdout '"points":\['
stdout '"ticket":"https://github.com/sandbox-org/single-task/issues/CC-1"'
stdout '"waste_pct_week":'

# An unrecognised repo scope excludes the merged ticket entirely.
exec cc request GET '/insights.json?since=2019-12-01&repo=not-a-repo'
! stdout '"ticket":"https://github.com/sandbox-org/single-task/issues/CC-1"'
stdout '"points":\[\]'
