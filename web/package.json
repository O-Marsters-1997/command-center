{
  "name": "command-center-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "tailwindcss -i ./app.css -o ../internal/cc/assets/dist/app.css --minify && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "dependencies": {
    "solid-element": "^1.9.1",
    "solid-js": "^1.9.15"
  },
  "trustedDependencies": ["@biomejs/biome", "@parcel/watcher"]
}
